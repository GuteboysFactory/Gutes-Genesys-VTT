<section class="genesys-sheet-body genesys-sheet-v15 genesys-theme-fantasy genesys-target-v153" data-genesys-sheet-tabs data-actor-name="{{actor.name}}">
  <header class="genesys-hero-header genesys-header-wizard-baseline">
    <div class="genesys-portrait-column">
      <div class="genesys-portrait-frame">
        <img class="genesys-portrait" src="{{actor.img}}" alt="{{actor.name}}" />
      </div>
    </div>

    <div class="genesys-character-identity">
      <input class="genesys-name" type="text" name="name" value="{{actor.name}}" {{#unless editable}}disabled{{/unless}} />
      <div class="genesys-character-subline">
        <input type="text" name="system.profile.archetype" value="{{system.profile.archetype}}" placeholder="Archetype / Species" {{#unless editable}}disabled{{/unless}} />
        <span>·</span>
        <input type="text" name="system.profile.career" value="{{system.profile.career}}" placeholder="Career" {{#unless editable}}disabled{{/unless}} />
      </div>
      <div class="genesys-identity-meta">
        <span><strong>Role:</strong> {{actorProfile.roleLabel}}</span>
        <span><strong>Silhouette:</strong> {{system.silhouette}}</span>
        {{#if system.adversaryRank}}<span><strong>Adversary:</strong> {{system.adversaryRank}}</span>{{/if}}
        {{#if initiative.active}}<span><strong>Encounter:</strong> Round {{initiative.round}}</span>{{/if}}
      </div>
    </div>

    <div class="genesys-header-actions">
      <button type="button" class="genesys-header-button" data-open-tab="notes" title="Actor configuration">⚙ Configure</button>
      <div class="genesys-rank-seal" title="Character overview emblem">
        <span>{{system.characteristics.brawn}}</span>
        <small>BRAWN</small>
      </div>
      <small class="genesys-build-id">v{{systemVersion}} · Foundry {{foundryVersion}}</small>
    </div>
  </header>

  <nav class="genesys-sheet-tabs" aria-label="Character sheet sections">
    <button type="button" class="active" data-genesys-tab="summary">Summary</button>
    <button type="button" data-genesys-tab="skills">Skills</button>
    <button type="button" data-genesys-tab="talents">Talents</button>
    <button type="button" data-genesys-tab="equipment">Equipment</button>
    <button type="button" data-genesys-tab="effects">Effects</button>
    <button type="button" data-genesys-tab="notes">Notes</button>
  </nav>

  <div class="genesys-tab-panel active" data-genesys-tab-panel="summary">
    <div class="genesys-summary-grid genesys-summary-grid-target">
      <div class="genesys-summary-left">
        <section class="genesys-fantasy-panel genesys-ornate-panel genesys-summary-characteristics">
          <div class="genesys-panel-banner"><h2>Characteristics</h2></div>
          <div class="genesys-characteristic-medallions">
            <label class="genesys-characteristic-card">
              <span class="genesys-characteristic-name">Brawn</span><i class="fa-solid fa-hand-fist" aria-hidden="true"></i>
              <input type="number" name="system.characteristics.brawn" value="{{system.characteristics.brawn}}" min="1" max="6" {{#unless editable}}disabled{{/unless}} />
            </label>
            <label class="genesys-characteristic-card">
              <span class="genesys-characteristic-name">Agility</span><i class="fa-solid fa-person-running" aria-hidden="true"></i>
              <input type="number" name="system.characteristics.agility" value="{{system.characteristics.agility}}" min="1" max="6" {{#unless editable}}disabled{{/unless}} />
            </label>
            <label class="genesys-characteristic-card">
              <span class="genesys-characteristic-name">Intellect</span><i class="fa-solid fa-book-open" aria-hidden="true"></i>
              <input type="number" name="system.characteristics.intellect" value="{{system.characteristics.intellect}}" min="1" max="6" {{#unless editable}}disabled{{/unless}} />
            </label>
            <label class="genesys-characteristic-card">
              <span class="genesys-characteristic-name">Cunning</span><i class="fa-solid fa-mask" aria-hidden="true"></i>
              <input type="number" name="system.characteristics.cunning" value="{{system.characteristics.cunning}}" min="1" max="6" {{#unless editable}}disabled{{/unless}} />
            </label>
            <label class="genesys-characteristic-card">
              <span class="genesys-characteristic-name">Willpower</span><i class="fa-solid fa-sun" aria-hidden="true"></i>
              <input type="number" name="system.characteristics.willpower" value="{{system.characteristics.willpower}}" min="1" max="6" {{#unless editable}}disabled{{/unless}} />
            </label>
            <label class="genesys-characteristic-card">
              <span class="genesys-characteristic-name">Presence</span><i class="fa-solid fa-crown" aria-hidden="true"></i>
              <input type="number" name="system.characteristics.presence" value="{{system.characteristics.presence}}" min="1" max="6" {{#unless editable}}disabled{{/unless}} />
            </label>
          </div>
        </section>

        <section class="genesys-fantasy-panel genesys-ornate-panel genesys-summary-vitals">
          <div class="genesys-panel-banner"><h2>Defense &amp; Resilience</h2></div>
          <div class="genesys-defense-strip">
            <label><i class="fa-solid fa-shield-halved" aria-hidden="true"></i><span>Soak</span><input type="number" name="system.soak" value="{{system.soak}}" min="0" {{#unless editable}}disabled{{/unless}} /></label>
            <label><i class="fa-solid fa-shield" aria-hidden="true"></i><span>Melee Defense</span><input type="number" name="system.defense.melee" value="{{system.defense.melee}}" min="0" {{#unless editable}}disabled{{/unless}} /></label>
            <label><i class="fa-regular fa-compass" aria-hidden="true"></i><span>Ranged Defense</span><input type="number" name="system.defense.ranged" value="{{system.defense.ranged}}" min="0" {{#unless editable}}disabled{{/unless}} /></label>
          </div>

          <div class="genesys-resource-tracks">
            <div class="genesys-resource-card genesys-resource-wounds" data-resource-track="wounds" data-current="{{system.wounds.value}}" data-threshold="{{#if actorProfile.roleMinion}}{{adversary.minionGroup.groupWoundThreshold}}{{else}}{{system.wounds.threshold}}{{/if}}">
              <div class="genesys-resource-heading"><i class="fa-solid fa-heart" aria-hidden="true"></i><strong>Wounds</strong><div class="genesys-vital-pair"><input type="number" name="system.wounds.value" value="{{system.wounds.value}}" min="0" {{#unless editable}}disabled{{/unless}} /><span>/</span>{{#if actorProfile.roleMinion}}<input type="number" value="{{adversary.minionGroup.groupWoundThreshold}}" disabled />{{else}}<input type="number" name="system.wounds.threshold" value="{{system.wounds.threshold}}" min="0" {{#unless editable}}disabled{{/unless}} />{{/if}}</div></div>
              <div class="genesys-track-boxes" data-resource-boxes aria-hidden="true"></div>
            </div>
            <div class="genesys-resource-card genesys-resource-strain" data-resource-track="strain" data-current="{{system.strain.value}}" data-threshold="{{system.strain.threshold}}">
              <div class="genesys-resource-heading"><i class="fa-solid fa-circle-notch" aria-hidden="true"></i><strong>Strain</strong>{{#if adversary.tracksStrain}}<div class="genesys-vital-pair"><input type="number" name="system.strain.value" value="{{system.strain.value}}" min="0" {{#unless editable}}disabled{{/unless}} /><span>/</span><input type="number" name="system.strain.threshold" value="{{system.strain.threshold}}" min="0" {{#unless editable}}disabled{{/unless}} /></div>{{else}}<span class="genesys-muted">Not tracked</span>{{/if}}</div>
              {{#if adversary.tracksStrain}}<div class="genesys-track-boxes" data-resource-boxes aria-hidden="true"></div>{{/if}}
            </div>
          </div>

          <div class="genesys-vital-footer">
            <span><strong>Silhouette</strong> {{system.silhouette}}</span>
            {{#if actorProfile.roleMinion}}<span><strong>Members</strong> {{adversary.minionGroup.remainingMembers}} / {{adversary.minionGroup.members}}</span>{{/if}}
            <span><strong>Current State</strong> {{#if conditionSummary.active.length}}Affected{{else}}Healthy{{/if}}</span>
          </div>
        </section>
      </div>

      <div class="genesys-summary-center">
        <section class="genesys-fantasy-panel genesys-ornate-panel genesys-quick-pool" data-quick-dice-pool>
          <div class="genesys-panel-banner"><h2>Quick Dice Pool</h2></div>
          <div class="genesys-quick-dice-row">
            <button type="button" class="genesys-quick-die die-boost" data-quick-die="boost" title="Boost"><span class="die-glyph">◆</span><strong data-quick-count>0</strong></button>
            <button type="button" class="genesys-quick-die die-ability" data-quick-die="ability" title="Ability"><span class="die-glyph">◆</span><strong data-quick-count>0</strong></button>
            <button type="button" class="genesys-quick-die die-proficiency" data-quick-die="proficiency" title="Proficiency"><span class="die-glyph">✦</span><strong data-quick-count>0</strong></button>
            <button type="button" class="genesys-quick-die die-setback" data-quick-die="setback" title="Setback"><span class="die-glyph">●</span><strong data-quick-count>0</strong></button>
            <button type="button" class="genesys-quick-die die-difficulty" data-quick-die="difficulty" title="Difficulty"><span class="die-glyph">⬢</span><strong data-quick-count>0</strong></button>
            <button type="button" class="genesys-quick-die die-challenge" data-quick-die="challenge" title="Challenge"><span class="die-glyph">▼</span><strong data-quick-count>0</strong></button>
          </div>
          <div class="genesys-quick-pool-actions"><button type="button" class="genesys-primary-action" data-quick-roll><i class="fa-solid fa-dice" aria-hidden="true"></i> Roll Dice</button><button type="button" class="genesys-secondary-action" data-quick-clear>Clear</button></div>
        </section>

        <section class="genesys-fantasy-panel genesys-ornate-panel genesys-summary-talents">
          <div class="genesys-panel-banner genesys-panel-banner-action"><h2>Talents (Active)</h2><button type="button" data-open-tab="talents">View All</button></div>
          <div class="genesys-summary-list genesys-talent-quick-list">
            {{#each talents}}
              <div class="genesys-summary-row genesys-talent-quick-row" data-item-id="{{id}}">
                <button type="button" class="genesys-icon-button" data-action="editItem" title="Open Talent"><i class="fa-solid fa-bolt" aria-hidden="true"></i></button>
                <strong>{{name}}</strong>
                <span class="genesys-mini-rank" data-mini-rank="{{rank}}">{{#if ranked}}Rank {{rank}}{{else}}Tier {{tier}}{{/if}}</span>
                <span class="genesys-talent-quick-text">{{activation}}</span>
                {{#if activeAction}}<button type="button" class="genesys-row-action" data-action="useTalent" data-source-id="{{activeAction.sourceId}}" data-rule-id="{{activeAction.ruleId}}" {{#unless activeAction.available}}disabled{{/unless}}>Use</button>{{/if}}
              </div>
            {{else}}<p class="genesys-empty-row">No Talents yet.</p>{{/each}}
          </div>
        </section>

        <section class="genesys-fantasy-panel genesys-ornate-panel genesys-summary-weapons">
          <div class="genesys-panel-banner genesys-panel-banner-action"><h2>Weapons (Equipped)</h2><button type="button" data-open-tab="equipment">View All</button></div>
          <div class="genesys-compact-table">
            <div class="genesys-compact-head"><span>Name</span><span>Skill</span><span>Damage</span><span>Range</span><span>Qualities</span></div>
            {{#each inventory.weapons}}
              <div class="genesys-compact-row" data-item-id="{{id}}"><button type="button" class="genesys-item-name" data-action="editItem">{{name}}</button><span>{{skillId}}</span><span>{{damage}}</span><span>{{range}}</span><span>{{qualitiesText}}</span></div>
            {{else}}<p class="genesys-empty-row">No weapons yet.</p>{{/each}}
          </div>
        </section>
      </div>

      <div class="genesys-summary-right">
        <section class="genesys-fantasy-panel genesys-ornate-panel genesys-summary-effects">
          <div class="genesys-panel-banner"><h2>Conditions</h2></div>
          <div class="genesys-condition-quick-grid">
            <button type="button" data-action="addCondition" data-condition-id="disoriented">○ Disoriented</button>
            <button type="button" data-action="addCondition" data-condition-id="staggered">○ Staggered</button>
            <button type="button" data-action="addCondition" data-condition-id="immobilized">○ Immobilized</button>
            {{#each conditionSummary.active}}<span class="genesys-condition-active">● {{conditionId}}</span>{{/each}}
          </div>
          <div class="genesys-critical-quick"><span><i class="fa-solid fa-circle-plus" aria-hidden="true"></i> <strong>Critical Injuries</strong> · {{criticals.length}}</span><button type="button" data-open-tab="effects">Manage</button></div>
        </section>

        <section class="genesys-fantasy-panel genesys-ornate-panel genesys-summary-equipment">
          <div class="genesys-panel-banner genesys-panel-banner-action"><h2>Equipment (Quick View)</h2><button type="button" data-open-tab="equipment">View All</button></div>
          <div class="genesys-equipment-quick-list">
            {{#each inventory.armor}}<div class="genesys-equipment-quick-row" data-item-id="{{id}}"><i class="fa-solid fa-shirt" aria-hidden="true"></i><button type="button" data-action="editItem">{{name}}</button><span>Armor</span><span>Enc {{encumbrance}}</span></div>{{/each}}
            {{#each inventory.gear}}<div class="genesys-equipment-quick-row" data-item-id="{{id}}"><i class="fa-solid fa-bag-shopping" aria-hidden="true"></i><button type="button" data-action="editItem">{{name}}{{#if quantity}} ({{quantity}}){{/if}}</button><span>Gear</span><span>Enc {{encumbrance}}</span></div>{{/each}}
            {{#unless inventory.armor.length}}{{#unless inventory.gear.length}}<p class="genesys-empty-row">No equipment yet.</p>{{/unless}}{{/unless}}
          </div>
        </section>

        <section class="genesys-fantasy-panel genesys-ornate-panel genesys-summary-notes">
          <div class="genesys-panel-banner genesys-panel-banner-action"><h2>Notes (Quick)</h2><button type="button" data-open-tab="notes">View All</button></div>
          <p class="genesys-notes-preview">{{system.profile.notes}}</p>
        </section>

        <section class="genesys-fantasy-panel genesys-ornate-panel genesys-summary-encounter genesys-initiative-panel">
          <div class="genesys-panel-banner"><h2>Encounter</h2></div>
          {{#if initiative.collecting}}
            <p>{{initiative.modeLabel}} · ready to collect initiative.</p>
            <div class="genesys-v15-actions"><label>Side<select data-initiative-side><option value="pc" {{#if initiative.sidePcSelected}}selected{{/if}}>PC</option><option value="npc" {{#if initiative.sideNpcSelected}}selected{{/if}}>NPC</option></select></label><label>Skill<select data-initiative-skill><option value="cool" {{#if initiative.skillCoolSelected}}selected{{/if}}>Cool</option><option value="vigilance" {{#if initiative.skillVigilanceSelected}}selected{{/if}}>Vigilance</option></select></label></div>
            <div class="genesys-v15-actions"><button type="button" data-action="rollInitiative">{{#if initiative.hasRolled}}Reroll Initiative{{else}}Roll Initiative{{/if}}</button><button type="button" data-action="startInitiative">Start Encounter</button><button type="button" data-action="openEncounterTracker">Open Tracker</button></div>
          {{else}}
            {{#if initiative.active}}<p><strong>Round {{initiative.round}}</strong> · Turn {{initiative.turnNumber}}/{{initiative.totalTurns}} · {{initiative.activeActorLabel}}</p>{{else}}<p>No active encounter.</p>{{/if}}
            <div class="genesys-v15-actions"><button type="button" data-action="openEncounterTracker">Open Encounter Tracker</button><button type="button" data-action="resetInitiative">Reset</button></div>
          {{/if}}
        </section>
      </div>
    </div>
  </div>

  <div class="genesys-tab-panel" data-genesys-tab-panel="skills" hidden>
    <section class="genesys-fantasy-panel genesys-ornate-panel genesys-skills-panel">
      <div class="genesys-panel-banner genesys-panel-banner-action"><div><h2>Skills</h2><p>Click a skill name to roll. Rank uses five direct-click pips.</p></div><span class="genesys-sheet-chip">{{activeProfileId}}</span></div>
      <details class="genesys-check-engine-lab"><summary>Advanced Check Setup</summary><div class="genesys-check-engine-controls"><label>Mode<select data-check-mode><option value="standard">Standard</option><option value="opposed">Opposed</option><option value="assisted">Assisted</option></select></label><label>Difficulty<input type="number" data-skill-difficulty value="2" min="0" max="5" /></label><label>Opponent Char<input type="number" data-opponent-characteristic value="2" min="0" max="10" /></label><label>Opponent Rank<input type="number" data-opponent-skill-rank value="2" min="0" max="10" /></label><label>Assistant Char<input type="number" data-assistant-characteristic value="2" min="0" max="10" /></label><label>Assistant Rank<input type="number" data-assistant-skill-rank value="2" min="0" max="10" /></label><label>Extra Helpers<input type="number" data-extra-helpers value="0" min="0" max="10" /></label></div></details>

      <details class="genesys-skill-group" open><summary>General</summary><div class="genesys-skill-table"><div class="genesys-skill-head"><span>Skill</span><span>Characteristic</span><span>Rank</span><span>{{#if actorProfile.roleMinion}}Group{{else}}Career{{/if}}</span></div>{{#each skills.general}}<div class="genesys-skill-row" data-skill-id="{{id}}" data-skill-index="{{index}}"><button type="button" class="genesys-skill-roll" data-action="rollSkill">{{label}}</button><span>{{characteristicLabel}}</span>{{#if ../actorProfile.roleMinion}}<span class="genesys-minion-derived-rank">{{rank}}</span><input type="checkbox" data-minion-group-skill {{checked groupSkill}} {{#unless ../editable}}disabled{{/unless}} />{{else}}<input type="number" data-skill-rank value="{{rank}}" min="0" max="5" {{#unless ../editable}}disabled{{/unless}} /><input type="checkbox" data-skill-career {{checked career}} {{#unless ../editable}}disabled{{/unless}} />{{/if}}</div>{{/each}}</div></details>
      <details class="genesys-skill-group" open><summary>Combat</summary><div class="genesys-skill-table"><div class="genesys-skill-head"><span>Skill</span><span>Characteristic</span><span>Rank</span><span>{{#if actorProfile.roleMinion}}Group{{else}}Career{{/if}}</span></div>{{#each skills.combat}}<div class="genesys-skill-row" data-skill-id="{{id}}" data-skill-index="{{index}}"><button type="button" class="genesys-skill-roll" data-action="rollSkill">{{label}}</button><span>{{characteristicLabel}}</span>{{#if ../actorProfile.roleMinion}}<span class="genesys-minion-derived-rank">{{rank}}</span><input type="checkbox" data-minion-group-skill {{checked groupSkill}} {{#unless ../editable}}disabled{{/unless}} />{{else}}<input type="number" data-skill-rank value="{{rank}}" min="0" max="5" {{#unless ../editable}}disabled{{/unless}} /><input type="checkbox" data-skill-career {{checked career}} {{#unless ../editable}}disabled{{/unless}} />{{/if}}</div>{{/each}}</div></details>
      <details class="genesys-skill-group"><summary>Knowledge / Specialized</summary><div class="genesys-skill-table"><div class="genesys-skill-head"><span>Skill</span><span>Characteristic</span><span>Rank</span><span>{{#if actorProfile.roleMinion}}Group{{else}}Career{{/if}}</span></div>{{#each skills.knowledge}}<div class="genesys-skill-row" data-skill-id="{{id}}" data-skill-index="{{index}}"><button type="button" class="genesys-skill-roll" data-action="rollSkill">{{label}}</button><span>{{characteristicLabel}}</span>{{#if ../actorProfile.roleMinion}}<span class="genesys-minion-derived-rank">{{rank}}</span><input type="checkbox" data-minion-group-skill {{checked groupSkill}} {{#unless ../editable}}disabled{{/unless}} />{{else}}<input type="number" data-skill-rank value="{{rank}}" min="0" max="5" {{#unless ../editable}}disabled{{/unless}} /><input type="checkbox" data-skill-career {{checked career}} {{#unless ../editable}}disabled{{/unless}} />{{/if}}</div>{{/each}}</div></details>
      <details class="genesys-skill-group"><summary>Magic</summary><div class="genesys-skill-table"><div class="genesys-skill-head"><span>Skill</span><span>Characteristic</span><span>Rank</span><span>{{#if actorProfile.roleMinion}}Group{{else}}Career{{/if}}</span></div>{{#each skills.magic}}<div class="genesys-skill-row" data-skill-id="{{id}}" data-skill-index="{{index}}"><button type="button" class="genesys-skill-roll" data-action="rollSkill">{{label}}</button><span>{{characteristicLabel}}</span>{{#if ../actorProfile.roleMinion}}<span class="genesys-minion-derived-rank">{{rank}}</span><input type="checkbox" data-minion-group-skill {{checked groupSkill}} {{#unless ../editable}}disabled{{/unless}} />{{else}}<input type="number" data-skill-rank value="{{rank}}" min="0" max="5" {{#unless ../editable}}disabled{{/unless}} /><input type="checkbox" data-skill-career {{checked career}} {{#unless ../editable}}disabled{{/unless}} />{{/if}}</div>{{/each}}</div></details>
    </section>
  </div>

  <div class="genesys-tab-panel" data-genesys-tab-panel="talents" hidden>
    <section class="genesys-fantasy-panel genesys-ornate-panel genesys-talents-main" data-talent-pyramid>
      <div class="genesys-panel-banner genesys-panel-banner-action"><div><h2>Talent Pyramid</h2><p>Talents are grouped by effective Tier. Ranked Talents show five rank pips.</p></div><div class="genesys-item-createbar"><button type="button" data-action="grantParry">+ Parry / Rank</button><button type="button" data-action="grantFinesse">+ Finesse</button><button type="button" data-action="grantSecondWind">+ Second Wind / Rank</button><button type="button" data-action="createItem" data-item-type="talent">+ Custom</button></div></div>

      <div class="genesys-pyramid-status">
        <div class="genesys-pyramid-status-row" data-tier-status="5"><strong>T5</strong><div class="genesys-tier-meter"><span data-tier-meter-fill></span></div><span data-tier-count>0</span></div>
        <div class="genesys-pyramid-status-row" data-tier-status="4"><strong>T4</strong><div class="genesys-tier-meter"><span data-tier-meter-fill></span></div><span data-tier-count>0</span></div>
        <div class="genesys-pyramid-status-row" data-tier-status="3"><strong>T3</strong><div class="genesys-tier-meter"><span data-tier-meter-fill></span></div><span data-tier-count>0</span></div>
        <div class="genesys-pyramid-status-row" data-tier-status="2"><strong>T2</strong><div class="genesys-tier-meter"><span data-tier-meter-fill></span></div><span data-tier-count>0</span></div>
        <div class="genesys-pyramid-status-row" data-tier-status="1"><strong>T1</strong><div class="genesys-tier-meter"><span data-tier-meter-fill></span></div><span data-tier-count>0</span></div>
      </div>

      <div class="genesys-talent-lanes">
        <section class="genesys-talent-lane" data-talent-lane="5"><header><strong>Tier 5</strong><span data-lane-count>0 Talents</span></header><div class="genesys-talent-card-grid" data-tier-cards></div></section>
        <section class="genesys-talent-lane" data-talent-lane="4"><header><strong>Tier 4</strong><span data-lane-count>0 Talents</span></header><div class="genesys-talent-card-grid" data-tier-cards></div></section>
        <section class="genesys-talent-lane" data-talent-lane="3"><header><strong>Tier 3</strong><span data-lane-count>0 Talents</span></header><div class="genesys-talent-card-grid" data-tier-cards></div></section>
        <section class="genesys-talent-lane" data-talent-lane="2"><header><strong>Tier 2</strong><span data-lane-count>0 Talents</span></header><div class="genesys-talent-card-grid" data-tier-cards></div></section>
        <section class="genesys-talent-lane" data-talent-lane="1"><header><strong>Tier 1</strong><span data-lane-count>0 Talents</span></header><div class="genesys-talent-card-grid" data-tier-cards></div></section>
      </div>

      <div class="genesys-talent-source" data-talent-source hidden>
        {{#each talents}}
          <article class="genesys-talent-card" data-item-id="{{id}}" data-tier="{{tier}}" data-talent-rank="{{rank}}" data-ranked="{{ranked}}">
            <div class="genesys-talent-card-title"><button type="button" class="genesys-item-name" data-action="editItem">{{name}}</button><span class="genesys-tier-badge">T{{tier}}</span></div>
            <div class="genesys-talent-rank-pips" data-talent-rank-pips aria-label="Talent rank"></div>
            <p>{{activation}}{{#unless enabled}} · Disabled{{/unless}}</p>
            <div class="genesys-talent-card-actions">{{#if activeAction}}<button type="button" data-action="useTalent" data-source-id="{{activeAction.sourceId}}" data-rule-id="{{activeAction.ruleId}}" {{#unless activeAction.available}}disabled{{/unless}}>Use</button>{{/if}}<button type="button" data-action="deleteItem">×</button></div>
          </article>
        {{else}}<p class="genesys-empty-row">No Talents yet.</p>{{/each}}
      </div>
    </section>
  </div>

  <div class="genesys-tab-panel" data-genesys-tab-panel="equipment" hidden>
    <section class="genesys-fantasy-panel genesys-ornate-panel genesys-inventory-panel">
      <div class="genesys-panel-banner genesys-panel-banner-action"><div><h2>Equipment</h2><p>Choose a target and range, then attack directly from a weapon row.</p></div><label class="genesys-weapon-difficulty">Raw Roll Difficulty<input type="number" data-weapon-difficulty value="2" min="0" max="5" /></label></div>
      <div class="genesys-combat-controls"><label>Combat Target<select data-combat-target><option value="">— Select Target —</option>{{#each combatTargets}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label><label>Target Range<select data-combat-range><option value="engaged">Engaged</option><option value="short">Short</option><option value="medium">Medium</option><option value="long">Long</option><option value="extreme">Extreme</option></select></label></div>
      <div class="genesys-item-createbar"><button type="button" data-action="createItem" data-item-type="weapon">+ Weapon</button><button type="button" data-action="createItem" data-item-type="armor">+ Armor</button><button type="button" data-action="createItem" data-item-type="gear">+ Gear</button><button type="button" data-action="createItem" data-item-type="attachment">+ Attachment</button></div>
      <details class="genesys-item-group" open><summary>Weapons ({{inventory.weapons.length}})</summary><div class="genesys-item-table genesys-weapon-table"><div class="genesys-item-head"><span>Name</span><span>Skill</span><span>Damage</span><span>Crit</span><span>Range</span><span>Qualities</span><span>Actions</span></div>{{#each inventory.weapons}}<div class="genesys-item-row" data-item-id="{{id}}"><button type="button" class="genesys-item-name" data-action="editItem">{{name}}</button><span>{{skillId}}</span><span>{{damage}}</span><span>{{critical}}</span><span>{{range}}</span><span>{{qualitiesText}}</span><span class="genesys-item-actions"><button type="button" data-action="rollCombatWeapon">Attack</button><button type="button" data-action="rollWeapon">Raw Roll</button><button type="button" data-action="deleteItem">×</button></span></div>{{else}}<p class="genesys-empty-row">No weapons yet.</p>{{/each}}</div></details>
      <details class="genesys-item-group"><summary>Armor ({{inventory.armor.length}})</summary><div class="genesys-item-table">{{#each inventory.armor}}<div class="genesys-item-row genesys-simple-item-row" data-item-id="{{id}}"><button type="button" class="genesys-item-name" data-action="editItem">{{name}}</button><span>Soak {{soak}} · Defense {{defense}} · Enc {{encumbrance}} · HP {{hardPoints}} · {{qualitiesText}}</span><span class="genesys-item-actions"><button type="button" data-action="deleteItem">×</button></span></div>{{else}}<p class="genesys-empty-row">No armor yet.</p>{{/each}}</div></details>
      <details class="genesys-item-group"><summary>Gear ({{inventory.gear.length}})</summary><div class="genesys-item-table">{{#each inventory.gear}}<div class="genesys-item-row genesys-simple-item-row" data-item-id="{{id}}"><button type="button" class="genesys-item-name" data-action="editItem">{{name}}</button><span>Qty {{quantity}} · Enc {{encumbrance}}</span><span class="genesys-item-actions"><button type="button" data-action="deleteItem">×</button></span></div>{{else}}<p class="genesys-empty-row">No gear yet.</p>{{/each}}</div></details>
      <details class="genesys-item-group"><summary>Attachments ({{inventory.attachments.length}})</summary><div class="genesys-item-table">{{#each inventory.attachments}}<div class="genesys-item-row genesys-simple-item-row" data-item-id="{{id}}"><button type="button" class="genesys-item-name" data-action="editItem">{{name}}</button><span>HP {{hardPointCost}} · {{#if installed}}Installed{{else}}Not installed{{/if}} · {{qualitiesText}}</span><span class="genesys-item-actions"><button type="button" data-action="deleteItem">×</button></span></div>{{else}}<p class="genesys-empty-row">No attachments yet.</p>{{/each}}</div></details>
    </section>
  </div>

  <div class="genesys-tab-panel" data-genesys-tab-panel="effects" hidden>
    <div class="genesys-effects-grid">
      <section class="genesys-fantasy-panel genesys-ornate-panel genesys-condition-panel"><div class="genesys-panel-banner"><h2>Conditions</h2></div><div class="genesys-v15-actions"><button type="button" data-action="addCondition" data-condition-id="staggered">+ Staggered</button><button type="button" data-action="addCondition" data-condition-id="immobilized">+ Immobilized</button><button type="button" data-action="addCondition" data-condition-id="disoriented">+ Disoriented</button></div><div class="genesys-condition-list">{{#each conditionSummary.active}}<div class="genesys-condition-row"><span><strong>{{conditionId}}</strong> · {{durationType}}{{#if remaining}} · {{remaining}}{{/if}}</span><button type="button" data-action="removeCondition" data-condition-state-id="{{id}}">×</button></div>{{else}}<p class="genesys-empty-row">No active conditions.</p>{{/each}}</div></section>
      {{#unless actorProfile.roleMinion}}<section class="genesys-fantasy-panel genesys-ornate-panel genesys-critical-panel"><div class="genesys-panel-banner genesys-panel-banner-action"><h2>Critical Injuries</h2><span class="genesys-sheet-chip">Next +{{criticalModifier}}</span></div><div class="genesys-critical-list">{{#each criticals}}<div class="genesys-critical-row" data-critical-id="{{id}}"><div><strong>{{name}}</strong> <span>({{severityLabel}} · Heal {{difficultyLabel}})</span><br /><small>d100 {{rawRoll}} → {{total}} · {{effect}}</small>{{#if secondarySummary}}<br /><small><strong>{{secondarySummary}}</strong></small>{{/if}}</div><div class="genesys-critical-actions">{{#if needsSecondaryResolution}}<button type="button" data-action="resolveCriticalSecondary">Resolve Effect</button>{{/if}}<button type="button" data-action="healCritical">Mark Healed</button></div></div>{{else}}<p class="genesys-empty-row">No unresolved Critical Injuries.</p>{{/each}}</div><details class="genesys-v15-advanced"><summary>Manual Critical Test Controls</summary><div class="genesys-v15-detail-body genesys-critical-lab"><div class="genesys-v15-advanced-grid"><label>Vicious Rank<input type="number" data-critical-vicious value="0" min="0" max="10" /></label><label>Extra Crit Activations<input type="number" data-critical-extra-activations value="0" min="0" max="10" /></label><label>Other Modifier<input type="number" data-critical-flat-modifier value="0" min="-150" max="150" /></label></div><button type="button" data-action="rollCritical">Roll Critical</button></div></details></section>{{else}}<section class="genesys-fantasy-panel genesys-ornate-panel"><div class="genesys-panel-banner"><h2>Minion Criticals</h2></div><p>Minion groups use their shared group state instead of persistent Critical Injury records.</p></section>{{/unless}}
    </div>
  </div>

  <div class="genesys-tab-panel" data-genesys-tab-panel="notes" hidden>
    <div class="genesys-notes-grid">
      <section class="genesys-fantasy-panel genesys-ornate-panel"><div class="genesys-panel-banner"><h2>Character Notes</h2></div><label class="genesys-notes-field">Background<textarea name="system.profile.background" rows="6" {{#unless editable}}disabled{{/unless}}>{{system.profile.background}}</textarea></label><label class="genesys-notes-field">Notes<textarea name="system.profile.notes" rows="12" {{#unless editable}}disabled{{/unless}}>{{system.profile.notes}}</textarea></label></section>
      <section class="genesys-fantasy-panel genesys-ornate-panel"><div class="genesys-panel-banner"><h2>Configure Actor</h2></div><div class="genesys-v15-profile-grid"><label>Role<select name="system.role" {{#unless editable}}disabled{{/unless}}><option value="pc" {{#if actorProfile.rolePc}}selected{{/if}}>PC</option><option value="minion" {{#if actorProfile.roleMinion}}selected{{/if}}>Minion</option><option value="rival" {{#if actorProfile.roleRival}}selected{{/if}}>Rival</option><option value="nemesis" {{#if actorProfile.roleNemesis}}selected{{/if}}>Nemesis</option></select></label><label>Silhouette<input type="number" name="system.silhouette" value="{{system.silhouette}}" min="0" max="10" {{#unless editable}}disabled{{/unless}} /></label><label>Adversary Rank<input type="number" name="system.adversaryRank" value="{{system.adversaryRank}}" min="0" max="10" {{#unless editable}}disabled{{/unless}} /></label>{{#if actorProfile.roleNemesis}}<label>Nemesis Extra Activation<select name="system.extraActivations" {{#unless editable}}disabled{{/unless}}><option value="0" {{#if actorProfile.nemesisExtraOff}}selected{{/if}}>Off · 1 activation</option><option value="1" {{#if actorProfile.nemesisExtraOn}}selected{{/if}}>On · 2 activations</option></select></label>{{else}}<label>Extra Activations<input type="number" name="system.extraActivations" value="{{system.extraActivations}}" min="0" max="10" {{#unless editable}}disabled{{/unless}} /></label>{{/if}}</div>{{#if actorProfile.roleMinion}}<div class="genesys-v15-minion-grid"><label>Group Size<input type="number" name="system.minionGroup.members" value="{{system.minionGroup.members}}" min="1" max="50" {{#unless editable}}disabled{{/unless}} /></label><label>Member WT<input type="number" name="system.minionGroup.memberWoundThreshold" value="{{system.minionGroup.memberWoundThreshold}}" min="1" max="100" {{#unless editable}}disabled{{/unless}} /></label><label>Defeated Members<input type="number" name="system.minionGroup.casualties" value="{{system.minionGroup.casualties}}" min="0" max="{{system.minionGroup.members}}" {{#unless editable}}disabled{{/unless}} /></label></div>{{/if}}</section>
      <details class="genesys-v15-advanced genesys-fantasy-panel"><summary>Advanced / QA Tools</summary><div class="genesys-v15-detail-body"><details class="genesys-reaction-lab"><summary>Legacy Reaction Test Lab</summary><div class="genesys-reaction-lab-grid"><label class="genesys-item-check"><input type="checkbox" data-dev-parry-enabled {{#if reactionDev.parryEnabled}}checked{{/if}} {{#unless editable}}disabled{{/unless}} /> Enable legacy Parry test reaction</label><label>Parry Rank<input type="number" data-dev-parry-rank value="{{reactionDev.parryRank}}" min="1" max="5" {{#unless editable}}disabled{{/unless}} /></label></div></details><section class="genesys-pool-builder"><div class="genesys-panel-heading"><div><h2>Standard Pool Builder</h2><p>Independent regression surface.</p></div><button type="button" data-action="constructAndRoll">Build &amp; Roll</button></div><div class="genesys-builder-basics"><label>Characteristic<select data-check-characteristic><option value="{{system.characteristics.brawn}}">Brawn ({{system.characteristics.brawn}})</option><option value="{{system.characteristics.agility}}">Agility ({{system.characteristics.agility}})</option><option value="{{system.characteristics.intellect}}">Intellect ({{system.characteristics.intellect}})</option><option value="{{system.characteristics.cunning}}">Cunning ({{system.characteristics.cunning}})</option><option value="{{system.characteristics.willpower}}">Willpower ({{system.characteristics.willpower}})</option><option value="{{system.characteristics.presence}}">Presence ({{system.characteristics.presence}})</option></select></label><label>Skill Rank<input type="number" data-check-skill-rank value="0" min="0" max="5" /></label><label>Base Difficulty<input type="number" data-check-difficulty value="2" min="0" max="5" /></label></div><div class="genesys-builder-groups"><fieldset><legend>Add Dice</legend><label>Boost<input type="number" data-add-die="boost" value="0" min="0" max="20" /></label><label>Ability<input type="number" data-add-die="ability" value="0" min="0" max="20" /></label><label>Setback<input type="number" data-add-die="setback" value="0" min="0" max="20" /></label><label>Difficulty<input type="number" data-add-die="difficulty" value="0" min="0" max="20" /></label></fieldset><fieldset><legend>Up / Down</legend><label>Upgrade +<input type="number" data-upgrade-positive value="0" min="0" max="20" /></label><label>Upgrade −<input type="number" data-upgrade-negative value="0" min="0" max="20" /></label><label>Downgrade +<input type="number" data-downgrade-positive value="0" min="0" max="20" /></label><label>Downgrade −<input type="number" data-downgrade-negative value="0" min="0" max="20" /></label></fieldset><fieldset><legend>Remove Dice</legend><label>Boost<input type="number" data-remove-die="boost" value="0" min="0" max="20" /></label><label>Ability<input type="number" data-remove-die="ability" value="0" min="0" max="20" /></label><label>Proficiency<input type="number" data-remove-die="proficiency" value="0" min="0" max="20" /></label><label>Setback<input type="number" data-remove-die="setback" value="0" min="0" max="20" /></label><label>Difficulty<input type="number" data-remove-die="difficulty" value="0" min="0" max="20" /></label><label>Challenge<input type="number" data-remove-die="challenge" value="0" min="0" max="20" /></label></fieldset></div></section></div></details>
    </div>
  </div>

  <footer class="genesys-sheet-footer"><span>PEOPLE</span><b>•</b><span>STORIES</span><b>•</b><span>DICE</span><b>•</b><span>A BRIGHTER TOMORROW</span><div class="genesys-footer-brand">GENESYS</div></footer>
</section>