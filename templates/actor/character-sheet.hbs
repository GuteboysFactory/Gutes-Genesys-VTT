<section class="genesys-sheet-body genesys-sheet-v15">
  <header class="genesys-sheet-header">
    <div>
      <p class="genesys-eyebrow">GENESYS VTT · v{{systemVersion}}</p>
      <input class="genesys-name" type="text" name="name" value="{{actor.name}}" {{#unless editable}}disabled{{/unless}} />
      <div class="genesys-sheet-roleline">
        <span class="genesys-sheet-chip">{{actorProfile.roleLabel}}</span>
        <span class="genesys-sheet-chip">Silhouette {{system.silhouette}}</span>
        {{#if system.adversaryRank}}<span class="genesys-sheet-chip">Adversary {{system.adversaryRank}}</span>{{/if}}
        {{#if actorProfile.roleNemesis}}{{#if actorProfile.nemesisExtraOn}}<span class="genesys-sheet-chip">2 Activations / Round</span>{{/if}}{{/if}}
        {{#if initiative.active}}<span class="genesys-sheet-chip">Encounter · Round {{initiative.round}}</span>{{/if}}
      </div>
    </div>
    <div class="genesys-runtime" title="Runtime compatibility target">Foundry {{foundryVersion}}</div>
  </header>

  <section class="genesys-v15-dashboard">
    <div class="genesys-panel genesys-v15-core">
      <div class="genesys-v15-section-title">
        <div><h2>Core Characteristics</h2><p>The six characteristics and the values you need most often at the table.</p></div>
      </div>

      <div class="genesys-v15-characteristics">
        <label class="genesys-v15-characteristic"><span>Brawn</span><input type="number" name="system.characteristics.brawn" value="{{system.characteristics.brawn}}" min="1" max="6" {{#unless editable}}disabled{{/unless}} /></label>
        <label class="genesys-v15-characteristic"><span>Agility</span><input type="number" name="system.characteristics.agility" value="{{system.characteristics.agility}}" min="1" max="6" {{#unless editable}}disabled{{/unless}} /></label>
        <label class="genesys-v15-characteristic"><span>Intellect</span><input type="number" name="system.characteristics.intellect" value="{{system.characteristics.intellect}}" min="1" max="6" {{#unless editable}}disabled{{/unless}} /></label>
        <label class="genesys-v15-characteristic"><span>Cunning</span><input type="number" name="system.characteristics.cunning" value="{{system.characteristics.cunning}}" min="1" max="6" {{#unless editable}}disabled{{/unless}} /></label>
        <label class="genesys-v15-characteristic"><span>Willpower</span><input type="number" name="system.characteristics.willpower" value="{{system.characteristics.willpower}}" min="1" max="6" {{#unless editable}}disabled{{/unless}} /></label>
        <label class="genesys-v15-characteristic"><span>Presence</span><input type="number" name="system.characteristics.presence" value="{{system.characteristics.presence}}" min="1" max="6" {{#unless editable}}disabled{{/unless}} /></label>
      </div>

      <div class="genesys-v15-vitals">
        <div class="genesys-vital-card">
          <strong>Wounds</strong>
          <div class="genesys-vital-pair">
            <input aria-label="Current wounds" type="number" name="system.wounds.value" value="{{system.wounds.value}}" min="0" {{#unless editable}}disabled{{/unless}} />
            <span>/</span>
            {{#if actorProfile.roleMinion}}
              <input aria-label="Group wound threshold" type="number" value="{{adversary.minionGroup.groupWoundThreshold}}" disabled />
            {{else}}
              <input aria-label="Wound threshold" type="number" name="system.wounds.threshold" value="{{system.wounds.threshold}}" min="0" {{#unless editable}}disabled{{/unless}} />
            {{/if}}
          </div>
        </div>

        <div class="genesys-vital-card">
          <strong>Strain</strong>
          {{#if adversary.tracksStrain}}
            <div class="genesys-vital-pair">
              <input aria-label="Current strain" type="number" name="system.strain.value" value="{{system.strain.value}}" min="0" {{#unless editable}}disabled{{/unless}} />
              <span>/</span>
              <input aria-label="Strain threshold" type="number" name="system.strain.threshold" value="{{system.strain.threshold}}" min="0" {{#unless editable}}disabled{{/unless}} />
            </div>
          {{else}}
            <span>Not tracked</span>
          {{/if}}
        </div>

        <label class="genesys-vital-card"><strong>Soak</strong><input type="number" name="system.soak" value="{{system.soak}}" min="0" {{#unless editable}}disabled{{/unless}} /></label>
        <label class="genesys-vital-card"><strong>Melee Defense</strong><input type="number" name="system.defense.melee" value="{{system.defense.melee}}" min="0" {{#unless editable}}disabled{{/unless}} /></label>
        <label class="genesys-vital-card"><strong>Ranged Defense</strong><input type="number" name="system.defense.ranged" value="{{system.defense.ranged}}" min="0" {{#unless editable}}disabled{{/unless}} /></label>
      </div>
    </div>

    <div class="genesys-v15-status-stack">
      <section class="genesys-panel genesys-v15-status-card genesys-condition-panel">
        <h2>Current State</h2>
        <div class="genesys-v15-status-summary">
          <span class="genesys-sheet-chip">Actions: {{#if conditionRules.canPerformActions}}Ready{{else}}Blocked{{/if}}</span>
          <span class="genesys-sheet-chip">Maneuvers: {{#if conditionRules.canPerformManeuvers}}Ready{{else}}Blocked{{/if}}</span>
          {{#each conditionSummary.active}}<span class="genesys-sheet-chip" data-tone="alert">{{conditionId}}</span>{{/each}}
        </div>
        <div class="genesys-v15-actions">
          <button type="button" data-action="addCondition" data-condition-id="staggered">+ Staggered</button>
          <button type="button" data-action="addCondition" data-condition-id="immobilized">+ Immobilized</button>
          <button type="button" data-action="addCondition" data-condition-id="disoriented">+ Disoriented</button>
        </div>
        {{#each conditionSummary.active}}
          <div class="genesys-condition-row">
            <span><strong>{{conditionId}}</strong> · {{durationType}}{{#if remaining}} · {{remaining}}{{/if}}</span>
            <button type="button" data-action="removeCondition" data-condition-state-id="{{id}}">×</button>
          </div>
        {{/each}}
      </section>

      <section class="genesys-panel genesys-v15-status-card genesys-initiative-panel">
        <h2>Encounter</h2>
        {{#if initiative.collecting}}
          <p>{{initiative.modeLabel}} · waiting for encounter start.</p>
          <div class="genesys-v15-actions">
            <label>Side
              <select data-initiative-side>
                <option value="pc" {{#if initiative.sidePcSelected}}selected{{/if}}>PC</option>
                <option value="npc" {{#if initiative.sideNpcSelected}}selected{{/if}}>NPC</option>
              </select>
            </label>
            <label>Skill
              <select data-initiative-skill>
                <option value="cool" {{#if initiative.skillCoolSelected}}selected{{/if}}>Cool</option>
                <option value="vigilance" {{#if initiative.skillVigilanceSelected}}selected{{/if}}>Vigilance</option>
              </select>
            </label>
          </div>
          <div class="genesys-v15-actions">
            <button type="button" data-action="rollInitiative">{{#if initiative.hasRolled}}Reroll Initiative{{else}}Roll Initiative{{/if}}</button>
            <button type="button" data-action="startInitiative">Start Encounter</button>
            <button type="button" data-action="openEncounterTracker">Open Tracker</button>
          </div>
        {{else}}
          {{#if initiative.active}}
            <p><strong>Round {{initiative.round}}</strong> · Turn {{initiative.turnNumber}} / {{initiative.totalTurns}}</p>
            <p>Current: <strong>{{initiative.activeActorLabel}}</strong></p>
          {{else}}
            <p>Encounter ended.</p>
          {{/if}}
          <div class="genesys-v15-actions">
            <button type="button" data-action="openEncounterTracker">Open Encounter Tracker</button>
            <button type="button" data-action="resetInitiative">Reset</button>
          </div>
        {{/if}}
      </section>
    </div>
  </section>

  <section class="genesys-v15-main-grid">
    <section class="genesys-panel genesys-inventory-panel">
      <div class="genesys-v15-section-title">
        <div><h2>Combat &amp; Equipment</h2><p>Choose a target and range, then attack directly from the weapon row. Inventory remains fully editable.</p></div>
        <label class="genesys-weapon-difficulty">Raw Roll Difficulty<input type="number" data-weapon-difficulty value="2" min="0" max="5" /></label>
      </div>

      <div class="genesys-combat-controls">
        <label>Combat Target
          <select data-combat-target>
            <option value="">— Select Target —</option>
            {{#each combatTargets}}<option value="{{id}}">{{name}}</option>{{/each}}
          </select>
        </label>
        <label>Target Range
          <select data-combat-range>
            <option value="engaged">Engaged</option>
            <option value="short">Short</option>
            <option value="medium">Medium</option>
            <option value="long">Long</option>
            <option value="extreme">Extreme</option>
          </select>
        </label>
      </div>

      <div class="genesys-item-createbar">
        <button type="button" data-action="createItem" data-item-type="weapon">+ Weapon</button>
        <button type="button" data-action="createItem" data-item-type="armor">+ Armor</button>
        <button type="button" data-action="createItem" data-item-type="gear">+ Gear</button>
        <button type="button" data-action="createItem" data-item-type="attachment">+ Attachment</button>
      </div>

      <details class="genesys-item-group" open>
        <summary>Weapons ({{inventory.weapons.length}})</summary>
        <div class="genesys-item-table genesys-weapon-table">
          <div class="genesys-item-head"><span>Name</span><span>Skill</span><span>Damage</span><span>Crit</span><span>Range</span><span>Qualities</span><span>Actions</span></div>
          {{#each inventory.weapons}}
            <div class="genesys-item-row" data-item-id="{{id}}">
              <button type="button" class="genesys-item-name" data-action="editItem">{{name}}</button>
              <span>{{skillId}}</span><span>{{damage}}</span><span>{{critical}}</span><span>{{range}}</span><span class="genesys-item-qualities">{{qualitiesText}}</span>
              <span class="genesys-item-actions"><button type="button" data-action="rollCombatWeapon">Attack</button><button type="button" data-action="rollWeapon" title="Raw mechanics roll">Raw Roll</button><button type="button" data-action="deleteItem">×</button></span>
            </div>
          {{else}}<p class="genesys-empty-row">No weapons yet.</p>{{/each}}
        </div>
      </details>

      <details class="genesys-item-group">
        <summary>Armor ({{inventory.armor.length}})</summary>
        <div class="genesys-item-table">
          {{#each inventory.armor}}
            <div class="genesys-item-row genesys-simple-item-row" data-item-id="{{id}}">
              <button type="button" class="genesys-item-name" data-action="editItem">{{name}}</button>
              <span>Soak {{soak}} · Defense {{defense}} · Enc {{encumbrance}} · HP {{hardPoints}} · {{qualitiesText}}</span>
              <span class="genesys-item-actions"><button type="button" data-action="deleteItem">×</button></span>
            </div>
          {{else}}<p class="genesys-empty-row">No armor yet.</p>{{/each}}
        </div>
      </details>

      <details class="genesys-item-group">
        <summary>Gear ({{inventory.gear.length}})</summary>
        <div class="genesys-item-table">
          {{#each inventory.gear}}
            <div class="genesys-item-row genesys-simple-item-row" data-item-id="{{id}}">
              <button type="button" class="genesys-item-name" data-action="editItem">{{name}}</button>
              <span>Qty {{quantity}} · Enc {{encumbrance}}</span>
              <span class="genesys-item-actions"><button type="button" data-action="deleteItem">×</button></span>
            </div>
          {{else}}<p class="genesys-empty-row">No gear yet.</p>{{/each}}
        </div>
      </details>

      <details class="genesys-item-group">
        <summary>Attachments ({{inventory.attachments.length}})</summary>
        <div class="genesys-item-table">
          {{#each inventory.attachments}}
            <div class="genesys-item-row genesys-simple-item-row" data-item-id="{{id}}">
              <button type="button" class="genesys-item-name" data-action="editItem">{{name}}</button>
              <span>HP cost {{hardPointCost}} · {{#if installed}}Installed{{else}}Not installed{{/if}} · {{qualitiesText}}</span>
              <span class="genesys-item-actions"><button type="button" data-action="deleteItem">×</button></span>
            </div>
          {{else}}<p class="genesys-empty-row">No attachments yet.</p>{{/each}}
        </div>
      </details>
    </section>

    <section class="genesys-panel genesys-skills-panel">
      <div class="genesys-v15-section-title">
        <div><h2>Skills</h2><p>Click a skill name to roll. Active rules such as Finesse can still modify the check before the pool is built.</p></div>
        <span class="genesys-sheet-chip">Profile: {{activeProfileId}}</span>
      </div>

      <details class="genesys-check-engine-lab">
        <summary>Advanced Check Setup</summary>
        <div class="genesys-check-engine-controls">
          <label>Mode<select data-check-mode><option value="standard">Standard</option><option value="opposed">Opposed</option><option value="assisted">Assisted</option></select></label>
          <label>Difficulty<input type="number" data-skill-difficulty value="2" min="0" max="5" /></label>
          <label>Opponent Char<input type="number" data-opponent-characteristic value="2" min="0" max="10" /></label>
          <label>Opponent Rank<input type="number" data-opponent-skill-rank value="2" min="0" max="10" /></label>
          <label>Assistant Char<input type="number" data-assistant-characteristic value="2" min="0" max="10" /></label>
          <label>Assistant Rank<input type="number" data-assistant-skill-rank value="2" min="0" max="10" /></label>
          <label>Extra Helpers<input type="number" data-extra-helpers value="0" min="0" max="10" /></label>
        </div>
      </details>

      <details class="genesys-skill-group" open>
        <summary>General</summary>
        <div class="genesys-skill-table">
          <div class="genesys-skill-head"><span>Skill</span><span>Characteristic</span><span>Rank</span><span>{{#if actorProfile.roleMinion}}Group Skill{{else}}Career{{/if}}</span></div>
          {{#each skills.general}}
            <div class="genesys-skill-row" data-skill-id="{{id}}" data-skill-index="{{index}}">
              <button type="button" class="genesys-skill-roll" data-action="rollSkill">{{label}}</button><span class="genesys-skill-characteristic">{{characteristicLabel}}</span>
              {{#if ../actorProfile.roleMinion}}<span class="genesys-minion-derived-rank">{{rank}}</span><input type="checkbox" data-minion-group-skill {{checked groupSkill}} {{#unless ../editable}}disabled{{/unless}} />{{else}}<input type="number" data-skill-rank value="{{rank}}" min="0" max="5" {{#unless ../editable}}disabled{{/unless}} /><input type="checkbox" data-skill-career {{checked career}} {{#unless ../editable}}disabled{{/unless}} />{{/if}}
            </div>
          {{/each}}
        </div>
      </details>

      <details class="genesys-skill-group" open>
        <summary>Combat</summary>
        <div class="genesys-skill-table">
          <div class="genesys-skill-head"><span>Skill</span><span>Characteristic</span><span>Rank</span><span>{{#if actorProfile.roleMinion}}Group Skill{{else}}Career{{/if}}</span></div>
          {{#each skills.combat}}
            <div class="genesys-skill-row" data-skill-id="{{id}}" data-skill-index="{{index}}">
              <button type="button" class="genesys-skill-roll" data-action="rollSkill">{{label}}</button><span class="genesys-skill-characteristic">{{characteristicLabel}}</span>
              {{#if ../actorProfile.roleMinion}}<span class="genesys-minion-derived-rank">{{rank}}</span><input type="checkbox" data-minion-group-skill {{checked groupSkill}} {{#unless ../editable}}disabled{{/unless}} />{{else}}<input type="number" data-skill-rank value="{{rank}}" min="0" max="5" {{#unless ../editable}}disabled{{/unless}} /><input type="checkbox" data-skill-career {{checked career}} {{#unless ../editable}}disabled{{/unless}} />{{/if}}
            </div>
          {{/each}}
        </div>
      </details>

      <details class="genesys-skill-group">
        <summary>Knowledge / Specialized</summary>
        <div class="genesys-skill-table">
          <div class="genesys-skill-head"><span>Skill</span><span>Characteristic</span><span>Rank</span><span>{{#if actorProfile.roleMinion}}Group Skill{{else}}Career{{/if}}</span></div>
          {{#each skills.knowledge}}
            <div class="genesys-skill-row" data-skill-id="{{id}}" data-skill-index="{{index}}">
              <button type="button" class="genesys-skill-roll" data-action="rollSkill">{{label}}</button><span class="genesys-skill-characteristic">{{characteristicLabel}}</span>
              {{#if ../actorProfile.roleMinion}}<span class="genesys-minion-derived-rank">{{rank}}</span><input type="checkbox" data-minion-group-skill {{checked groupSkill}} {{#unless ../editable}}disabled{{/unless}} />{{else}}<input type="number" data-skill-rank value="{{rank}}" min="0" max="5" {{#unless ../editable}}disabled{{/unless}} /><input type="checkbox" data-skill-career {{checked career}} {{#unless ../editable}}disabled{{/unless}} />{{/if}}
            </div>
          {{/each}}
        </div>
      </details>

      <details class="genesys-skill-group">
        <summary>Magic</summary>
        <div class="genesys-skill-table">
          <div class="genesys-skill-head"><span>Skill</span><span>Characteristic</span><span>Rank</span><span>{{#if actorProfile.roleMinion}}Group Skill{{else}}Career{{/if}}</span></div>
          {{#each skills.magic}}
            <div class="genesys-skill-row" data-skill-id="{{id}}" data-skill-index="{{index}}">
              <button type="button" class="genesys-skill-roll" data-action="rollSkill">{{label}}</button><span class="genesys-skill-characteristic">{{characteristicLabel}}</span>
              {{#if ../actorProfile.roleMinion}}<span class="genesys-minion-derived-rank">{{rank}}</span><input type="checkbox" data-minion-group-skill {{checked groupSkill}} {{#unless ../editable}}disabled{{/unless}} />{{else}}<input type="number" data-skill-rank value="{{rank}}" min="0" max="5" {{#unless ../editable}}disabled{{/unless}} /><input type="checkbox" data-skill-career {{checked career}} {{#unless ../editable}}disabled{{/unless}} />{{/if}}
            </div>
          {{/each}}
        </div>
      </details>
    </section>

    {{#unless actorProfile.roleMinion}}
      <section class="genesys-panel genesys-critical-panel">
        <div class="genesys-v15-section-title">
          <div><h2>Critical Injuries</h2><p>Unresolved Critical Injuries remain visible here; manual test controls are tucked away below.</p></div>
          <span class="genesys-sheet-chip">Next Crit +{{criticalModifier}}</span>
        </div>
        <div class="genesys-critical-list">
          {{#each criticals}}
            <div class="genesys-critical-row" data-critical-id="{{id}}">
              <div><strong>{{name}}</strong> <span>({{severityLabel}} · Heal {{difficultyLabel}})</span><br /><small>d100 {{rawRoll}} → {{total}} · {{effect}}</small>{{#if secondarySummary}}<br /><small><strong>{{secondarySummary}}</strong></small>{{/if}}</div>
              <div class="genesys-critical-actions">{{#if needsSecondaryResolution}}<button type="button" data-action="resolveCriticalSecondary">Resolve Effect</button>{{/if}}<button type="button" data-action="healCritical">Mark Healed</button></div>
            </div>
          {{else}}<p class="genesys-empty-row">No unresolved Critical Injuries.</p>{{/each}}
        </div>
        <details class="genesys-v15-advanced">
          <summary>Manual Critical Test Controls</summary>
          <div class="genesys-v15-detail-body genesys-critical-lab">
            <div class="genesys-v15-advanced-grid">
              <label>Vicious Rank<input type="number" data-critical-vicious value="0" min="0" max="10" /></label>
              <label>Extra Crit Activations<input type="number" data-critical-extra-activations value="0" min="0" max="10" /></label>
              <label>Other Modifier<input type="number" data-critical-flat-modifier value="0" min="-150" max="150" /></label>
            </div>
            <button type="button" data-action="rollCritical">Roll Critical</button>
          </div>
        </details>
      </section>
    {{else}}
      <section class="genesys-panel genesys-critical-panel"><h2>Minion Criticals</h2><p>Minion groups do not keep Critical Injury records. Criticals are applied to the shared group state.</p></section>
    {{/unless}}

    <details class="genesys-v15-profile-details">
      <summary>Profile &amp; GM Configuration</summary>
      <div class="genesys-v15-detail-body">
        <div class="genesys-v15-profile-grid">
          <label>Role
            <select name="system.role" {{#unless editable}}disabled{{/unless}}>
              <option value="pc" {{#if actorProfile.rolePc}}selected{{/if}}>PC</option>
              <option value="minion" {{#if actorProfile.roleMinion}}selected{{/if}}>Minion</option>
              <option value="rival" {{#if actorProfile.roleRival}}selected{{/if}}>Rival</option>
              <option value="nemesis" {{#if actorProfile.roleNemesis}}selected{{/if}}>Nemesis</option>
            </select>
          </label>
          <label>Silhouette<input type="number" name="system.silhouette" value="{{system.silhouette}}" min="0" max="10" {{#unless editable}}disabled{{/unless}} /></label>
          <label>Adversary Rank<input type="number" name="system.adversaryRank" value="{{system.adversaryRank}}" min="0" max="10" {{#unless editable}}disabled{{/unless}} /></label>
          {{#if actorProfile.roleNemesis}}
            <label>Nemesis Extra Activation
              <select name="system.extraActivations" {{#unless editable}}disabled{{/unless}}>
                <option value="0" {{#if actorProfile.nemesisExtraOff}}selected{{/if}}>Off — 1 activation</option>
                <option value="1" {{#if actorProfile.nemesisExtraOn}}selected{{/if}}>On — 2 activations</option>
              </select>
            </label>
          {{else}}
            <label>Extra Activations (custom)<input type="number" name="system.extraActivations" value="{{system.extraActivations}}" min="0" max="10" {{#unless editable}}disabled{{/unless}} /></label>
          {{/if}}
        </div>
        {{#if actorProfile.roleMinion}}
          <div class="genesys-v15-minion-grid">
            <label>Group Size<input type="number" name="system.minionGroup.members" value="{{system.minionGroup.members}}" min="1" max="50" {{#unless editable}}disabled{{/unless}} /></label>
            <label>Member Wound Threshold<input type="number" name="system.minionGroup.memberWoundThreshold" value="{{system.minionGroup.memberWoundThreshold}}" min="1" max="100" {{#unless editable}}disabled{{/unless}} /></label>
            <label>Defeated Members<input type="number" name="system.minionGroup.casualties" value="{{system.minionGroup.casualties}}" min="0" max="{{system.minionGroup.members}}" {{#unless editable}}disabled{{/unless}} /></label>
          </div>
          <p class="genesys-v15-qa-note">Combined WT {{adversary.minionGroup.groupWoundThreshold}} · Members remaining {{adversary.minionGroup.remainingMembers}} / {{adversary.minionGroup.members}} · listed group skills use remaining members − 1.</p>
        {{/if}}
      </div>
    </details>

    <details class="genesys-v15-advanced">
      <summary>Advanced / QA Tools</summary>
      <div class="genesys-v15-detail-body">
        <p class="genesys-v15-qa-note">These are development and regression tools. They remain available for QA but are no longer part of the normal play surface.</p>

        <details class="genesys-reaction-lab">
          <summary>Legacy Reaction Test Lab</summary>
          <div class="genesys-reaction-lab-grid">
            <label class="genesys-item-check"><input type="checkbox" data-dev-parry-enabled {{#if reactionDev.parryEnabled}}checked{{/if}} {{#unless editable}}disabled{{/unless}} /> Enable legacy Parry test reaction</label>
            <label>Parry Rank<input type="number" data-dev-parry-rank value="{{reactionDev.parryRank}}" min="1" max="5" {{#unless editable}}disabled{{/unless}} /></label>
          </div>
        </details>

        <section class="genesys-pool-builder">
          <div class="genesys-panel-heading"><div><h2>Standard Pool Builder</h2><p>Independent pool construction regression surface.</p></div><button type="button" data-action="constructAndRoll">Build &amp; Roll</button></div>
          <div class="genesys-builder-basics">
            <label>Characteristic<select data-check-characteristic><option value="{{system.characteristics.brawn}}">Brawn ({{system.characteristics.brawn}})</option><option value="{{system.characteristics.agility}}">Agility ({{system.characteristics.agility}})</option><option value="{{system.characteristics.intellect}}">Intellect ({{system.characteristics.intellect}})</option><option value="{{system.characteristics.cunning}}">Cunning ({{system.characteristics.cunning}})</option><option value="{{system.characteristics.willpower}}">Willpower ({{system.characteristics.willpower}})</option><option value="{{system.characteristics.presence}}">Presence ({{system.characteristics.presence}})</option></select></label>
            <label>Skill Rank<input type="number" data-check-skill-rank value="0" min="0" max="5" /></label>
            <label>Base Difficulty<input type="number" data-check-difficulty value="2" min="0" max="5" /></label>
          </div>
          <div class="genesys-builder-groups">
