<section class="genesys-sheet-body genesys-sheet-v15 genesys-theme-fantasy" data-genesys-sheet-tabs data-actor-name="{{actor.name}}">
  <header class="genesys-fantasy-header">
    <div class="genesys-portrait-frame">
      <img class="genesys-portrait" src="{{actor.img}}" alt="{{actor.name}}" />
    </div>
    <div class="genesys-character-identity">
      <p class="genesys-eyebrow">GENESYS · FANTASY</p>
      <input class="genesys-name" type="text" name="name" value="{{actor.name}}" {{#unless editable}}disabled{{/unless}} />
      <div class="genesys-identity-grid">
        <label>Archetype<input type="text" name="system.profile.archetype" value="{{system.profile.archetype}}" placeholder="Archetype / Species" {{#unless editable}}disabled{{/unless}} /></label>
        <label>Career<input type="text" name="system.profile.career" value="{{system.profile.career}}" placeholder="Career" {{#unless editable}}disabled{{/unless}} /></label>
        <label>Motivation<input type="text" name="system.profile.motivation" value="{{system.profile.motivation}}" placeholder="Motivation" {{#unless editable}}disabled{{/unless}} /></label>
      </div>
    </div>
    <div class="genesys-header-status">
      <span class="genesys-sheet-chip">{{actorProfile.roleLabel}}</span>
      <span class="genesys-sheet-chip">Silhouette {{system.silhouette}}</span>
      {{#if system.adversaryRank}}<span class="genesys-sheet-chip">Adversary {{system.adversaryRank}}</span>{{/if}}
      {{#if initiative.active}}<span class="genesys-sheet-chip">Round {{initiative.round}}</span>{{/if}}
      <small>v{{systemVersion}} · Foundry {{foundryVersion}}</small>
    </div>
  </header>

  <nav class="genesys-sheet-tabs" aria-label="Character sheet sections">
    <button type="button" class="active" data-genesys-tab="summary">Summary</button>
    <button type="button" data-genesys-tab="skills">Skills</button>
    <button type="button" data-genesys-tab="talents">Talents</button>
    <button type="button" data-genesys-tab="equipment">Equipment</button>
    <button type="button" data-genesys-tab="effects">Effects</button>
    <button type="button" data-genesys-tab="notes">Notes</button>
  </nav>

  <div class="genesys-tab-panel active" data-genesys-tab-panel="summary">
    <div class="genesys-summary-grid">
      <section class="genesys-fantasy-panel genesys-summary-characteristics">
        <h2>Characteristics</h2>
        <div class="genesys-characteristic-medallions">
          <label><span>Brawn</span><input type="number" name="system.characteristics.brawn" value="{{system.characteristics.brawn}}" min="1" max="6" {{#unless editable}}disabled{{/unless}} /></label>
          <label><span>Agility</span><input type="number" name="system.characteristics.agility" value="{{system.characteristics.agility}}" min="1" max="6" {{#unless editable}}disabled{{/unless}} /></label>
          <label><span>Intellect</span><input type="number" name="system.characteristics.intellect" value="{{system.characteristics.intellect}}" min="1" max="6" {{#unless editable}}disabled{{/unless}} /></label>
          <label><span>Cunning</span><input type="number" name="system.characteristics.cunning" value="{{system.characteristics.cunning}}" min="1" max="6" {{#unless editable}}disabled{{/unless}} /></label>
          <label><span>Willpower</span><input type="number" name="system.characteristics.willpower" value="{{system.characteristics.willpower}}" min="1" max="6" {{#unless editable}}disabled{{/unless}} /></label>
          <label><span>Presence</span><input type="number" name="system.characteristics.presence" value="{{system.characteristics.presence}}" min="1" max="6" {{#unless editable}}disabled{{/unless}} /></label>
        </div>
      </section>

      <section class="genesys-fantasy-panel genesys-quick-pool" data-quick-dice-pool>
        <div class="genesys-panel-title-row"><h2>Quick Dice Pool</h2><button type="button" class="genesys-text-button" data-quick-clear>Clear</button></div>
        <p class="genesys-panel-help">Left-click adds a die. Right-click removes one. The pool stays until you clear it.</p>
        <div class="genesys-quick-dice-row">
          <button type="button" class="genesys-quick-die die-boost" data-quick-die="boost" title="Boost"><span class="die-glyph">◆</span><strong data-quick-count>0</strong></button>
          <button type="button" class="genesys-quick-die die-ability" data-quick-die="ability" title="Ability"><span class="die-glyph">⬟</span><strong data-quick-count>0</strong></button>
          <button type="button" class="genesys-quick-die die-proficiency" data-quick-die="proficiency" title="Proficiency"><span class="die-glyph">✦</span><strong data-quick-count>0</strong></button>
          <button type="button" class="genesys-quick-die die-setback" data-quick-die="setback" title="Setback"><span class="die-glyph">■</span><strong data-quick-count>0</strong></button>
          <button type="button" class="genesys-quick-die die-difficulty" data-quick-die="difficulty" title="Difficulty"><span class="die-glyph">⬢</span><strong data-quick-count>0</strong></button>
          <button type="button" class="genesys-quick-die die-challenge" data-quick-die="challenge" title="Challenge"><span class="die-glyph">▼</span><strong data-quick-count>0</strong></button>
        </div>
        <button type="button" class="genesys-primary-action" data-quick-roll>Roll Dice</button>
      </section>

      <section class="genesys-fantasy-panel genesys-summary-vitals">
        <h2>Defense &amp; Resilience</h2>
        <div class="genesys-vital-stat-grid">
          <label><span>Soak</span><input type="number" name="system.soak" value="{{system.soak}}" min="0" {{#unless editable}}disabled{{/unless}} /></label>
          <label><span>Melee Defense</span><input type="number" name="system.defense.melee" value="{{system.defense.melee}}" min="0" {{#unless editable}}disabled{{/unless}} /></label>
          <label><span>Ranged Defense</span><input type="number" name="system.defense.ranged" value="{{system.defense.ranged}}" min="0" {{#unless editable}}disabled{{/unless}} /></label>
        </div>
        <div class="genesys-resource-tracks">
          <div class="genesys-resource-card">
            <strong>Wounds</strong>
            <div class="genesys-vital-pair"><input type="number" name="system.wounds.value" value="{{system.wounds.value}}" min="0" {{#unless editable}}disabled{{/unless}} /><span>/</span>{{#if actorProfile.roleMinion}}<input type="number" value="{{adversary.minionGroup.groupWoundThreshold}}" disabled />{{else}}<input type="number" name="system.wounds.threshold" value="{{system.wounds.threshold}}" min="0" {{#unless editable}}disabled{{/unless}} />{{/if}}</div>
          </div>
          <div class="genesys-resource-card">
            <strong>Strain</strong>
            {{#if adversary.tracksStrain}}<div class="genesys-vital-pair"><input type="number" name="system.strain.value" value="{{system.strain.value}}" min="0" {{#unless editable}}disabled{{/unless}} /><span>/</span><input type="number" name="system.strain.threshold" value="{{system.strain.threshold}}" min="0" {{#unless editable}}disabled{{/unless}} /></div>{{else}}<span class="genesys-muted">Not tracked</span>{{/if}}
          </div>
        </div>
      </section>

      <section class="genesys-fantasy-panel genesys-summary-talents">
        <div class="genesys-panel-title-row"><h2>Talents · Quick View</h2><button type="button" class="genesys-text-button" data-open-tab="talents">View All</button></div>
        <div class="genesys-summary-list">
          {{#each talents}}
            <div class="genesys-summary-row"><strong>{{name}}{{#if ranked}} {{rank}}{{/if}}</strong><span>Tier {{tier}} · {{activation}}</span>{{#if activeAction}}<button type="button" data-action="useTalent" data-source-id="{{activeAction.sourceId}}" data-rule-id="{{activeAction.ruleId}}" {{#unless activeAction.available}}disabled{{/unless}}>Use</button>{{/if}}</div>
          {{else}}<p class="genesys-empty-row">No Talents yet.</p>{{/each}}
        </div>
      </section>

      <section class="genesys-fantasy-panel genesys-summary-effects">
        <div class="genesys-panel-title-row"><h2>Current State</h2><button type="button" class="genesys-text-button" data-open-tab="effects">Manage</button></div>
        <div class="genesys-v15-status-summary">
          <span class="genesys-sheet-chip">Actions: {{#if conditionRules.canPerformActions}}Ready{{else}}Blocked{{/if}}</span>
          <span class="genesys-sheet-chip">Maneuvers: {{#if conditionRules.canPerformManeuvers}}Ready{{else}}Blocked{{/if}}</span>
          {{#each conditionSummary.active}}<span class="genesys-sheet-chip" data-tone="alert">{{conditionId}}</span>{{/each}}
        </div>
        <p><strong>Critical Injuries:</strong> {{criticals.length}}</p>
      </section>

      <section class="genesys-fantasy-panel genesys-summary-weapons">
        <div class="genesys-panel-title-row"><h2>Weapons · Equipped</h2><button type="button" class="genesys-text-button" data-open-tab="equipment">View All</button></div>
        <div class="genesys-summary-list">
          {{#each inventory.weapons}}
            <div class="genesys-summary-row" data-item-id="{{id}}"><button type="button" class="genesys-item-name" data-action="editItem">{{name}}</button><span>{{skillId}} · Damage {{damage}} · Crit {{critical}} · {{range}}</span></div>
          {{else}}<p class="genesys-empty-row">No weapons yet.</p>{{/each}}
        </div>
      </section>

      <section class="genesys-fantasy-panel genesys-summary-encounter genesys-initiative-panel">
        <h2>Encounter</h2>
        {{#if initiative.collecting}}
          <p>{{initiative.modeLabel}} · ready to collect initiative.</p>
          <div class="genesys-v15-actions"><label>Side<select data-initiative-side><option value="pc" {{#if initiative.sidePcSelected}}selected{{/if}}>PC</option><option value="npc" {{#if initiative.sideNpcSelected}}selected{{/if}}>NPC</option></select></label><label>Skill<select data-initiative-skill><option value="cool" {{#if initiative.skillCoolSelected}}selected{{/if}}>Cool</option><option value="vigilance" {{#if initiative.skillVigilanceSelected}}selected{{/if}}>Vigilance</option></select></label></div>
          <div class="genesys-v15-actions"><button type="button" data-action="rollInitiative">{{#if initiative.hasRolled}}Reroll Initiative{{else}}Roll Initiative{{/if}}</button><button type="button" data-action="startInitiative">Start Encounter</button><button type="button" data-action="openEncounterTracker">Open Tracker</button></div>
        {{else}}
          {{#if initiative.active}}<p><strong>Round {{initiative.round}}</strong> · Turn {{initiative.turnNumber}}/{{initiative.totalTurns}} · {{initiative.activeActorLabel}}</p>{{else}}<p>No active encounter.</p>{{/if}}
          <div class="genesys-v15-actions"><button type="button" data-action="openEncounterTracker">Open Encounter Tracker</button><button type="button" data-action="resetInitiative">Reset</button></div>
        {{/if}}
      </section>
    </div>
  </div>

  <div class="genesys-tab-panel" data-genesys-tab-panel="skills" hidden>
    <section class="genesys-fantasy-panel genesys-skills-panel">
      <div class="genesys-panel-title-row"><div><h2>Skills</h2><p class="genesys-panel-help">Click a skill to roll. Rank remains editable directly on the sheet.</p></div><span class="genesys-sheet-chip">{{activeProfileId}}</span></div>
      <details class="genesys-check-engine-lab"><summary>Advanced Check Setup</summary><div class="genesys-check-engine-controls"><label>Mode<select data-check-mode><option value="standard">Standard</option><option value="opposed">Opposed</option><option value="assisted">Assisted</option></select></label><label>Difficulty<input type="number" data-skill-difficulty value="2" min="0" max="5" /></label><label>Opponent Char<input type="number" data-opponent-characteristic value="2" min="0" max="10" /></label><label>Opponent Rank<input type="number" data-opponent-skill-rank value="2" min="0" max="10" /></label><label>Assistant Char<input type="number" data-assistant-characteristic value="2" min="0" max="10" /></label><label>Assistant Rank<input type="number" data-assistant-skill-rank value="2" min="0" max="10" /></label><label>Extra Helpers<input type="number" data-extra-helpers value="0" min="0" max="10" /></label></div></details>
      {{#each skills}}
      {{/each}}
      <details class="genesys-skill-group" open><summary>General</summary><div class="genesys-skill-table"><div class="genesys-skill-head"><span>Skill</span><span>Characteristic</span><span>Rank</span><span>{{#if actorProfile.roleMinion}}Group{{else}}Career{{/if}}</span></div>{{#each skills.general}}<div class="genesys-skill-row" data-skill-id="{{id}}" data-skill-index="{{index}}"><button type="button" class="genesys-skill-roll" data-action="rollSkill">{{label}}</button><span>{{characteristicLabel}}</span>{{#if ../actorProfile.roleMinion}}<span>{{rank}}</span><input type="checkbox" data-minion-group-skill {{checked groupSkill}} {{#unless ../editable}}disabled{{/unless}} />{{else}}<input type="number" data-skill-rank value="{{rank}}" min="0" max="5" {{#unless ../editable}}disabled{{/unless}} /><input type="checkbox" data-skill-career {{checked career}} {{#unless ../editable}}disabled{{/unless}} />{{/if}}</div>{{/each}}</div></details>
      <details class="genesys-skill-group" open><summary>Combat</summary><div class="genesys-skill-table"><div class="genesys-skill-head"><span>Skill</span><span>Characteristic</span><span>Rank</span><span>{{#if actorProfile.roleMinion}}Group{{else}}Career{{/if}}</span></div>{{#each skills.combat}}<div class="genesys-skill-row" data-skill-id="{{id}}" data-skill-index="{{index}}"><button type="button" class="genesys-skill-roll" data-action="rollSkill">{{label}}</button><span>{{characteristicLabel}}</span>{{#if ../actorProfile.roleMinion}}<span>{{rank}}</span><input type="checkbox" data-minion-group-skill {{checked groupSkill}} {{#unless ../editable}}disabled{{/unless}} />{{else}}<input type="number" data-skill-rank value="{{rank}}" min="0" max="5" {{#unless ../editable}}disabled{{/unless}} /><input type="checkbox" data-skill-career {{checked career}} {{#unless ../editable}}disabled{{/unless}} />{{/if}}</div>{{/each}}</div></details>
      <details class="genesys-skill-group"><summary>Knowledge / Specialized</summary><div class="genesys-skill-table"><div class="genesys-skill-head"><span>Skill</span><span>Characteristic</span><span>Rank</span><span>{{#if actorProfile.roleMinion}}Group{{else}}Career{{/if}}</span></div>{{#each skills.knowledge}}<div class="genesys-skill-row" data-skill-id="{{id}}" data-skill-index="{{index}}"><button type="button" class="genesys-skill-roll" data-action="rollSkill">{{label}}</button><span>{{characteristicLabel}}</span>{{#if ../actorProfile.roleMinion}}<span>{{rank}}</span><input type="checkbox" data-minion-group-skill {{checked groupSkill}} {{#unless ../editable}}disabled{{/unless}} />{{else}}<input type="number" data-skill-rank value="{{rank}}" min="0" max="5" {{#unless ../editable}}disabled{{/unless}} /><input type="checkbox" data-skill-career {{checked career}} {{#unless ../editable}}disabled{{/unless}} />{{/if}}</div>{{/each}}</div></details>
      <details class="genesys-skill-group"><summary>Magic</summary><div class="genesys-skill-table"><div class="genesys-skill-head"><span>Skill</span><span>Characteristic</span><span>Rank</span><span>{{#if actorProfile.roleMinion}}Group{{else}}Career{{/if}}</span></div>{{#each skills.magic}}<div class="genesys-skill-row" data-skill-id="{{id}}" data-skill-index="{{index}}"><button type="button" class="genesys-skill-roll" data-action="rollSkill">{{label}}</button><span>{{characteristicLabel}}</span>{{#if ../actorProfile.roleMinion}}<span>{{rank}}</span><input type="checkbox" data-minion-group-skill {{checked groupSkill}} {{#unless ../editable}}disabled{{/unless}} />{{else}}<input type="number" data-skill-rank value="{{rank}}" min="0" max="5" {{#unless ../editable}}disabled{{/unless}} /><input type="checkbox" data-skill-career {{checked career}} {{#unless ../editable}}disabled{{/unless}} />{{/if}}</div>{{/each}}</div></details>
    </section>
  </div>

  <div class="genesys-tab-panel" data-genesys-tab-panel="talents" hidden>
    <section class="genesys-fantasy-panel genesys-talents-main">
      <div class="genesys-panel-title-row"><div><h2>Talents</h2><p class="genesys-panel-help">Passive, active, reaction, and encounter-scoped Talents powered by Rule Elements.</p></div></div>
      <div class="genesys-item-createbar"><button type="button" data-action="grantParry">+ Parry / Rank</button><button type="button" data-action="grantFinesse">+ Finesse</button><button type="button" data-action="grantSecondWind">+ Second Wind / Rank</button><button type="button" data-action="createItem" data-item-type="talent">+ Custom Talent</button></div>
      <div class="genesys-item-table">{{#each talents}}<div class="genesys-item-row genesys-simple-item-row" data-item-id="{{id}}"><button type="button" class="genesys-item-name" data-action="editItem">{{name}}{{#if ranked}} {{rank}}{{/if}}</button><span>Tier {{tier}} · {{activation}} · {{ruleCount}} Rule Element{{#unless enabled}} · Disabled{{/unless}}</span><span class="genesys-item-actions">{{#if activeAction}}<button type="button" data-action="useTalent" data-source-id="{{activeAction.sourceId}}" data-rule-id="{{activeAction.ruleId}}" {{#unless activeAction.available}}disabled{{/unless}}>Use</button>{{/if}}<button type="button" data-action="deleteItem">×</button></span></div>{{else}}<p class="genesys-empty-row">No Talents yet.</p>{{/each}}</div>
    </section>
  </div>

  <div class="genesys-tab-panel" data-genesys-tab-panel="equipment" hidden>
    <section class="genesys-fantasy-panel genesys-inventory-panel">
      <div class="genesys-panel-title-row"><div><h2>Equipment</h2><p class="genesys-panel-help">Attack directly from a weapon row after choosing target and range.</p></div><label class="genesys-weapon-difficulty">Raw Roll Difficulty<input type="number" data-weapon-difficulty value="2" min="0" max="5" /></label></div>
      <div class="genesys-combat-controls"><label>Combat Target<select data-combat-target><option value="">— Select Target —</option>{{#each combatTargets}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label><label>Target Range<select data-combat-range><option value="engaged">Engaged</option><option value="short">Short</option><option value="medium">Medium</option><option value="long">Long</option><option value="extreme">Extreme</option></select></label></div>
      <div class="genesys-item-createbar"><button type="button" data-action="createItem" data-item-type="weapon">+ Weapon</button><button type="button" data-action="createItem" data-item-type="armor">+ Armor</button><button type="button" data-action="createItem" data-item-type="gear">+ Gear</button><button type="button" data-action="createItem" data-item-type="attachment">+ Attachment</button></div>
      <details class="genesys-item-group" open><summary>Weapons ({{inventory.weapons.length}})</summary><div class="genesys-item-table genesys-weapon-table"><div class="genesys-item-head"><span>Name</span><span>Skill</span><span>Damage</span><span>Crit</span><span>Range</span><span>Qualities</span><span>Actions</span></div>{{#each inventory.weapons}}<div class="genesys-item-row" data-item-id="{{id}}"><button type="button" class="genesys-item-name" data-action="editItem">{{name}}</button><span>{{skillId}}</span><span>{{damage}}</span><span>{{critical}}</span><span>{{range}}</span><span>{{qualitiesText}}</span><span class="genesys-item-actions"><button type="button" data-action="rollCombatWeapon">Attack</button><button type="button" data-action="rollWeapon">Raw Roll</button><button type="button" data-action="deleteItem">×</button></span></div>{{else}}<p class="genesys-empty-row">No weapons yet.</p>{{/each}}</div></details>
      <details class="genesys-item-group"><summary>Armor ({{inventory.armor.length}})</summary><div class="genesys-item-table">{{#each inventory.armor}}<div class="genesys-item-row genesys-simple-item-row" data-item-id="{{id}}"><button type="button" class="genesys-item-name" data-action="editItem">{{name}}</button><span>Soak {{soak}} · Defense {{defense}} · Enc {{encumbrance}} · HP {{hardPoints}} · {{qualitiesText}}</span><span class="genesys-item-actions"><button type="button" data-action="deleteItem">×</button></span></div>{{else}}<p class="genesys-empty-row">No armor yet.</p>{{/each}}</div></details>
      <details class="genesys-item-group"><summary>Gear ({{inventory.gear.length}})</summary><div class="genesys-item-table">{{#each inventory.gear}}<div class="genesys-item-row genesys-simple-item-row" data-item-id="{{id}}"><button type="button" class="genesys-item-name" data-action="editItem">{{name}}</button><span>Qty {{quantity}} · Enc {{encumbrance}}</span><span class="genesys-item-actions"><button type="button" data-action="deleteItem">×</button></span></div>{{else}}<p class="genesys-empty-row">No gear yet.</p>{{/each}}</div></details>
      <details class="genesys-item-group"><summary>Attachments ({{inventory.attachments.length}})</summary><div class="genesys-item-table">{{#each inventory.attachments}}<div class="genesys-item-row genesys-simple-item-row" data-item-id="{{id}}"><button type="button" class="genesys-item-name" data-action="editItem">{{name}}</button><span>HP {{hardPointCost}} · {{#if installed}}Installed{{else}}Not installed{{/if}} · {{qualitiesText}}</span><span class="genesys-item-actions"><button type="button" data-action="deleteItem">×</button></span></div>{{else}}<p class="genesys-empty-row">No attachments yet.</p>{{/each}}</div></details>
    </section>
  </div>

  <div class="genesys-tab-panel" data-genesys-tab-panel="effects" hidden>
    <div class="genesys-effects-grid">
      <section class="genesys-fantasy-panel genesys-condition-panel"><h2>Conditions</h2><div class="genesys-v15-actions"><button type="button" data-action="addCondition" data-condition-id="staggered">+ Staggered</button><button type="button" data-action="addCondition" data-condition-id="immobilized">+ Immobilized</button><button type="button" data-action="addCondition" data-condition-id="disoriented">+ Disoriented</button></div><div class="genesys-condition-list">{{#each conditionSummary.active}}<div class="genesys-condition-row"><span><strong>{{conditionId}}</strong> · {{durationType}}{{#if remaining}} · {{remaining}}{{/if}}</span><button type="button" data-action="removeCondition" data-condition-state-id="{{id}}">×</button></div>{{else}}<p class="genesys-empty-row">No active conditions.</p>{{/each}}</div></section>
      {{#unless actorProfile.roleMinion}}<section class="genesys-fantasy-panel genesys-critical-panel"><div class="genesys-panel-title-row"><h2>Critical Injuries</h2><span class="genesys-sheet-chip">Next +{{criticalModifier}}</span></div><div class="genesys-critical-list">{{#each criticals}}<div class="genesys-critical-row" data-critical-id="{{id}}"><div><strong>{{name}}</strong> <span>({{severityLabel}} · Heal {{difficultyLabel}})</span><br /><small>d100 {{rawRoll}} → {{total}} · {{effect}}</small>{{#if secondarySummary}}<br /><small><strong>{{secondarySummary}}</strong></small>{{/if}}</div><div class="genesys-critical-actions">{{#if needsSecondaryResolution}}<button type="button" data-action="resolveCriticalSecondary">Resolve Effect</button>{{/if}}<button type="button" data-action="healCritical">Mark Healed</button></div></div>{{else}}<p class="genesys-empty-row">No unresolved Critical Injuries.</p>{{/each}}</div></section>{{else}}<section class="genesys-fantasy-panel"><h2>Minion Criticals</h2><p>Minion groups use their shared group state instead of persistent Critical Injury records.</p></section>{{/unless}}
    </div>
  </div>

  <div class="genesys-tab-panel" data-genesys-tab-panel="notes" hidden>
    <div class="genesys-notes-grid">
      <section class="genesys-fantasy-panel"><h2>Character Notes</h2><label class="genesys-notes-field">Background<textarea name="system.profile.background" rows="4" {{#unless editable}}disabled{{/unless}}>{{system.profile.background}}</textarea></label><label class="genesys-notes-field">Notes<textarea name="system.profile.notes" rows="10" {{#unless editable}}disabled{{/unless}}>{{system.profile.notes}}</textarea></label></section>
      <section class="genesys-fantasy-panel"><h2>Configure Actor</h2><div class="genesys-v15-profile-grid"><label>Role<select name="system.role" {{#unless editable}}disabled{{/unless}}><option value="pc" {{#if actorProfile.rolePc}}selected{{/if}}>PC</option><option value="minion" {{#if actorProfile.roleMinion}}selected{{/if}}>Minion</option><option value="rival" {{#if actorProfile.roleRival}}selected{{/if}}>Rival</option><option value="nemesis" {{#if actorProfile.roleNemesis}}selected{{/if}}>Nemesis</option></select></label><label>Silhouette<input type="number" name="system.silhouette" value="{{system.silhouette}}" min="0" max="10" {{#unless editable}}disabled{{/unless}} /></label><label>Adversary Rank<input type="number" name="system.adversaryRank" value="{{system.adversaryRank}}" min="0" max="10" {{#unless editable}}disabled{{/unless}} /></label>{{#if actorProfile.roleNemesis}}<label>Nemesis Extra Activation<select name="system.extraActivations" {{#unless editable}}disabled{{/unless}}><option value="0" {{#if actorProfile.nemesisExtraOff}}selected{{/if}}>Off · 1 activation</option><option value="1" {{#if actorProfile.nemesisExtraOn}}selected{{/if}}>On · 2 activations</option></select></label>{{else}}<label>Extra Activations<input type="number" name="system.extraActivations" value="{{system.extraActivations}}" min="0" max="10" {{#unless editable}}disabled{{/unless}} /></label>{{/if}}</div>{{#if actorProfile.roleMinion}}<div class="genesys-v15-minion-grid"><label>Group Size<input type="number" name="system.minionGroup.members" value="{{system.minionGroup.members}}" min="1" max="50" {{#unless editable}}disabled{{/unless}} /></label><label>Member WT<input type="number" name="system.minionGroup.memberWoundThreshold" value="{{system.minionGroup.memberWoundThreshold}}" min="1" max="100" {{#unless editable}}disabled{{/unless}} /></label><label>Defeated Members<input type="number" name="system.minionGroup.casualties" value="{{system.minionGroup.casualties}}" min="0" max="{{system.minionGroup.members}}" {{#unless editable}}disabled{{/unless}} /></label></div>{{/if}}</section>
    </div>

    <details class="genesys-v15-advanced"><summary>Advanced / QA Tools</summary><div class="genesys-v15-detail-body"><p class="genesys-v15-qa-note">Development and regression tools stay available here without occupying the play surface.</p><details class="genesys-reaction-lab"><summary>Legacy Reaction Test Lab</summary><div class="genesys-reaction-lab-grid"><label><input type="checkbox" data-dev-parry-enabled {{#if reactionDev.parryEnabled}}checked{{/if}} {{#unless editable}}disabled{{/unless}} /> Enable legacy Parry reaction</label><label>Parry Rank<input type="number" data-dev-parry-rank value="{{reactionDev.parryRank}}" min="1" max="5" {{#unless editable}}disabled{{/unless}} /></label></div></details><section class="genesys-dice-lab"><div class="genesys-panel-heading"><div><h2>Narrative Dice Lab</h2><p>Manual regression surface.</p></div><button type="button" data-action="rollNarrativeDice">Roll Pool</button></div><div class="genesys-dice-grid"><label class="genesys-die">Boost<input type="number" data-die-count="boost" value="0" min="0" max="20" /></label><label class="genesys-die">Ability<input type="number" data-die-count="ability" value="1" min="0" max="20" /></label><label class="genesys-die">Proficiency<input type="number" data-die-count="proficiency" value="0" min="0" max="20" /></label><label class="genesys-die">Setback<input type="number" data-die-count="setback" value="0" min="0" max="20" /></label><label class="genesys-die">Difficulty<input type="number" data-die-count="difficulty" value="1" min="0" max="20" /></label><label class="genesys-die">Challenge<input type="number" data-die-count="challenge" value="0" min="0" max="20" /></label></div></section>{{#unless actorProfile.roleMinion}}<section class="genesys-critical-panel"><h2>Manual Critical Test</h2><div class="genesys-v15-advanced-grid"><label>Vicious Rank<input type="number" data-critical-vicious value="0" min="0" max="10" /></label><label>Extra Activations<input type="number" data-critical-extra-activations value="0" min="0" max="10" /></label><label>Other Modifier<input type="number" data-critical-flat-modifier value="0" min="-150" max="150" /></label></div><button type="button" data-action="rollCritical">Roll Critical</button></section>{{/unless}}</div></details>
  </div>
</section>