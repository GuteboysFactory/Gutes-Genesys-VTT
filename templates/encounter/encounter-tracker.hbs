<section class="genesys-encounter-shell genesys-encounter-overhaul-v1824">
  <header class="genesys-encounter-header-v1824">
    <div class="genesys-encounter-title-v1824">
      <h1>Encounter Tracker</h1>
      <span class="genesys-encounter-mode-v1824">{{modeLabel}}</span>
      <span class="genesys-encounter-state-v1824">{{state.status}}</span>
    </div>
    {{#if active}}
      <div class="genesys-encounter-counter-v1824">
        <strong>Round {{round}}</strong>
        {{#if endRound}}<span>End of round</span>{{else}}<span>Turn {{turnNumber}} / {{totalTurns}}</span>{{/if}}
        {{#if isGM}}<span>Activations {{activationUsedCount}} / {{activationTotalCount}}</span>{{else}}<span>Acted {{actedCount}} / {{participantCount}}</span>{{/if}}
      </div>
    {{/if}}
  </header>

  {{#if encounterComplete}}
    <section class="genesys-encounter-complete-card genesys-encounter-complete-v1824">
      <div>
        <small>Encounter status</small>
        <h2>{{encounterOutcomeLabel}}</h2>
        <p>{{outcome.reason}}</p>
      </div>
      {{#if isGM}}
        <div class="genesys-active-turn-actions">
          <button type="button" data-action="endEncounter">End Encounter</button>
          <span class="genesys-gm-note">Keep it open only for aftermath, reinforcements, surrender, or special rules.</span>
        </div>
      {{/if}}
    </section>
  {{/if}}

  {{#if collecting}}
    <section class="genesys-encounter-setup-v1824">
      <div>
        <h2>Prepare Encounter</h2>
        <p>Choose an initiative mode, add participants, then roll Cool or Vigilance from their sheets.</p>
      </div>
      <div class="genesys-mode-choice">
        <button type="button" data-action="setModeSide" class="{{#if modeSide}}is-selected{{/if}}">Core Side Slots</button>
        <button type="button" data-action="setModePopcorn" class="{{#if modePopcorn}}is-selected{{/if}}">Popcorn Initiative</button>
      </div>
      {{#if isGM}}
        <div class="genesys-toolbar-actions">
          <button type="button" data-action="addSelectedTokens">+ Selected Tokens</button>
          <button type="button" data-action="startEncounter" {{#unless participantCount}}disabled{{/unless}}>Start Encounter</button>
          <button type="button" data-action="resetEncounter">Reset</button>
        </div>
      {{/if}}
    </section>
  {{/if}}

  {{#if active}}
    {{#if modeSide}}
      <section class="genesys-slot-stage-v1824">
        <div class="genesys-encounter-section-title-v1824">
          <div><h2>Initiative Slots</h2><p>Any eligible participant may claim a slot belonging to their side.</p></div>
          <span>Success → Advantage · PC wins exact tie</span>
        </div>
        <div class="genesys-slot-track-v1824">
          {{#each slots}}
            <article class="genesys-tracker-slot-v1824 {{#if active}}is-active{{/if}} {{#if completed}}is-complete{{/if}}" data-slot-index="{{index}}">
              <div class="genesys-slot-number-v1824">{{number}}</div>
              <div class="genesys-slot-copy-v1824">
                <strong>{{sideLabel}} Slot</strong>
                <span>Success {{success}} · Advantage {{advantage}}</span>
                <small>{{statusLabel}}</small>
              </div>
              {{#if @root.isGM}}
                <details class="genesys-slot-menu-v1824">
                  <summary aria-label="Slot controls"><i class="fa-solid fa-ellipsis-vertical"></i></summary>
                  <div>
                    <button type="button" data-action="slotUp">Move Up</button>
                    <button type="button" data-action="slotDown">Move Down</button>
                    <button type="button" data-action="slotToggleSide">Change PC/NPC</button>
                  </div>
                </details>
              {{/if}}
            </article>
          {{/each}}
        </div>
      </section>
    {{/if}}

    {{#if endRound}}
      {{#if hasActiveActor}}
        <section class="genesys-turn-focus-v1824 genesys-extra-turn-focus-v1825">
          <div class="genesys-turn-copy-v1824">
            <small>{{activeActivationLabel}}</small>
            <h2>{{activeActorLabel}}</h2>
            <div class="genesys-turn-budget-v1824">
              <span>Action <strong>{{#if activeActionBlocked}}Blocked{{else}}{{#if turn.actionUsed}}Used{{else}}Available{{/if}}{{/if}}</strong></span>
              <span>Maneuvers <strong>{{#if activeManeuverBlocked}}Blocked{{else}}{{turn.maneuversUsed}} / 2{{/if}}</strong></span>
            </div>
            <p>Complete this extra turn to mark its activation budget as used.</p>
          </div>
          <div class="genesys-active-turn-actions genesys-turn-actions-v1824">
            <button type="button" data-action="useAction" {{#unless canUseAction}}disabled{{/unless}}>Use Action</button>
            <button type="button" data-action="useManeuver" {{#unless canUseManeuver}}disabled{{/unless}}>Use Maneuver</button>
            <button type="button" data-action="endTurn">Mark Extra Activation Used</button>
            {{#if isGM}}<button type="button" data-action="unclaim">Unclaim</button>{{/if}}
          </div>
        </section>
      {{else}}
        <section class="genesys-turn-focus-v1824 genesys-end-round-focus-v1824">
          <div>
            <small>End of round</small>
            <h2>Round {{round}} complete</h2>
            {{#if pendingSpecialCount}}
              <p><strong>{{pendingSpecialCount}} Extra Activation(s) remain.</strong> Use them now or leave them unused when starting the next round.</p>
            {{else}}
              <p>All normal activations are complete. Resolve end-of-round effects before continuing.</p>
            {{/if}}
          </div>
          {{#if isGM}}<button type="button" data-action="startNextRound">Start Round {{nextRound}}</button>{{/if}}
        </section>
      {{/if}}
    {{else}}
      <section class="genesys-turn-focus-v1824">
        <div class="genesys-turn-copy-v1824">
          <small>{{#if hasActiveActor}}Active turn{{else}}Current activation{{/if}}</small>
          <h2>{{activeActorLabel}}</h2>
          {{#if hasActiveActor}}
            <div class="genesys-turn-budget-v1824">
              <span>Action <strong>{{#if activeActionBlocked}}Blocked{{else}}{{#if turn.actionUsed}}Used{{else}}Available{{/if}}{{/if}}</strong></span>
              <span>Maneuvers <strong>{{#if activeManeuverBlocked}}Blocked{{else}}{{turn.maneuversUsed}} / 2{{/if}}</strong></span>
            </div>
            {{#if activeActionBlocked}}<small class="genesys-blocked-note">Action blocked — {{activeActionBlockedReason}}</small>{{/if}}
            {{#if activeManeuverBlocked}}<small class="genesys-blocked-note">Maneuver blocked — {{activeManeuverBlockedReason}}</small>{{/if}}
          {{else}}
            <p>Select an eligible participant below to claim the open activation.</p>
          {{/if}}
        </div>
        {{#if hasActiveActor}}
          <div class="genesys-active-turn-actions genesys-turn-actions-v1824">
            <button type="button" data-action="useAction" {{#unless canUseAction}}disabled{{/unless}}>Use Action</button>
            <button type="button" data-action="useManeuver" {{#unless canUseManeuver}}disabled{{/unless}}>Use Maneuver</button>
            <button type="button" data-action="endTurn">End Turn</button>
            {{#if isGM}}<button type="button" data-action="unclaim">Unclaim</button>{{/if}}
          </div>
        {{/if}}
      </section>
    {{/if}}
  {{/if}}

  <div class="genesys-encounter-workspace-v1824">
    <main class="genesys-encounter-rosters-v1824">
      <section class="genesys-roster-v1824 genesys-roster-pc-v1824">
        <header><h2>Player Characters</h2><span>PC</span></header>
        <div class="genesys-roster-list-v1824">
          {{#each participants}}
            {{#if sidePc}}
              <article class="genesys-participant-card-v1824 health-{{healthId}} {{#if isActive}}is-active{{/if}} {{#if acted}}has-acted{{/if}}" data-actor-ref="{{actorRef}}">
                <div class="genesys-participant-heading-v1824">
                  <div><strong>{{label}}</strong><small>{{roleLabel}} · {{skillLabel}} {{success}}S / {{advantage}}A</small></div>
                  <div class="genesys-participant-state-v1824"><span>{{healthLabel}}</span><strong>{{activationBudgetUsed}} / {{activationBudgetTotal}}</strong><small>activations</small></div>
                </div>
                {{#if conditionLabels.length}}<small class="genesys-condition-line-v1824">Conditions: {{#each conditionLabels}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</small>{{/if}}
                {{#unless statusActive}}<span class="genesys-participant-status-badge status-{{encounterStatus}}">{{encounterStatusLabel}}</span>{{/unless}}
                {{#if canClaim}}<button type="button" class="genesys-claim-v1824" data-action="claimActor">Claim Turn</button>{{/if}}
                {{#if @root.isGM}}
                  <details class="genesys-participant-details-v1824">
                    <summary>GM details & controls</summary>
                    <div class="genesys-participant-exact-v1824">
                      <span>Wounds <strong>{{wounds}} / {{threshold}}</strong></span><span>Strain <strong>{{strain}} / {{strainThreshold}}</strong></span>
                      <span>Criticals <strong>{{criticalCount}}</strong></span><span>Silhouette <strong>{{silhouette}}</strong></span>
                    </div>
                    <div class="genesys-participant-actions">
                      {{#unless isActive}}<button type="button" data-action="forceClaimActor">GM Override</button>{{/unless}}
                      {{#if acted}}<button type="button" data-action="markUnacted">Mark Unacted</button>{{else}}<button type="button" data-action="markActed">Mark Acted</button>{{/if}}
                      {{#if statusActive}}<button type="button" data-action="markDefeated">Defeated</button><button type="button" data-action="markOutOfFight">Out of Fight</button><button type="button" data-action="markDead">Dead</button>{{else}}<button type="button" data-action="reactivateParticipant">Reactivate</button>{{/if}}
                      <button type="button" data-action="removeParticipant">Remove</button>
                    </div>
                  </details>
                {{/if}}
                {{#if hasActor}}<button type="button" class="genesys-open-sheet-v1824" data-action="openActor">Open Sheet</button>{{/if}}
              </article>
            {{/if}}
          {{/each}}
        </div>
      </section>

      <section class="genesys-roster-v1824 genesys-roster-npc-v1824">
        <header><h2>Hostile NPCs</h2><span>NPC</span></header>
        <div class="genesys-roster-list-v1824">
          {{#each participants}}
            {{#if sideNpc}}
              <article class="genesys-participant-card-v1824 health-{{healthId}} {{#if isActive}}is-active{{/if}} {{#if acted}}has-acted{{/if}}" data-actor-ref="{{actorRef}}">
                <div class="genesys-participant-heading-v1824">
                  <div><strong>{{label}}</strong><small>{{roleLabel}} · {{skillLabel}} {{success}}S / {{advantage}}A</small></div>
                  <div class="genesys-participant-state-v1824"><span>{{healthLabel}}</span><strong>{{activationBudgetUsed}} / {{activationBudgetTotal}}</strong><small>activations</small></div>
                </div>
                {{#if minionMembersTotal}}<small class="genesys-condition-line-v1824">Minions {{minionMembersRemaining}} / {{minionMembersTotal}}</small>{{/if}}
                {{#if conditionLabels.length}}<small class="genesys-condition-line-v1824">Conditions: {{#each conditionLabels}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</small>{{/if}}
                {{#unless statusActive}}<span class="genesys-participant-status-badge status-{{encounterStatus}}">{{encounterStatusLabel}}</span>{{/unless}}
                {{#if hasExtraActivation}}
                  <div class="genesys-activation-list-v1824">
                    {{#with extraActivation}}
                      <div data-activation-id="{{id}}"><span><strong>{{activationLabel}}</strong><small>{{statusLabel}}</small></span>{{#if available}}<button type="button" data-action="useActivation">Use Extra</button>{{/if}}</div>
                    {{/with}}
                  </div>
                {{/if}}
                {{#if canClaim}}<button type="button" class="genesys-claim-v1824" data-action="claimActor">Claim Turn</button>{{/if}}
                {{#if @root.isGM}}
                  <details class="genesys-participant-details-v1824">
                    <summary>GM details & controls</summary>
                    <div class="genesys-participant-exact-v1824">
                      <span>Wounds <strong>{{wounds}} / {{threshold}}</strong></span><span>Strain <strong>{{strain}} / {{strainThreshold}}</strong></span>
                      <span>Criticals <strong>{{criticalCount}}</strong></span>{{#if minionMembersTotal}}<span>Minions <strong>{{minionMembersRemaining}} / {{minionMembersTotal}}</strong></span>{{/if}}
                      <span>Silhouette <strong>{{silhouette}}</strong></span><span>Adversary <strong>{{adversaryRank}}</strong></span>
                    </div>
                    <div class="genesys-participant-actions">
                      {{#unless isActive}}<button type="button" data-action="forceClaimActor">GM Override</button>{{/unless}}
                      {{#if acted}}<button type="button" data-action="markUnacted">Mark Unacted</button>{{else}}<button type="button" data-action="markActed">Mark Acted</button>{{/if}}
                      {{#if statusActive}}<button type="button" data-action="markDefeated">Defeated</button><button type="button" data-action="markOutOfFight">Out of Fight</button><button type="button" data-action="markDead">Dead</button>{{else}}<button type="button" data-action="reactivateParticipant">Reactivate</button>{{/if}}
                      <button type="button" data-action="removeParticipant">Remove</button>
                    </div>
                  </details>
                {{/if}}
                {{#if hasActor}}<button type="button" class="genesys-open-sheet-v1824" data-action="openActor">Open Sheet</button>{{/if}}
              </article>
            {{/if}}
          {{/each}}
        </div>
      </section>

      {{#unless participantCount}}<p class="genesys-empty-row">No initiative participants yet.</p>{{/unless}}
    </main>

    <aside class="genesys-encounter-sidebar-v1824">
      <section>
        <h2>Round Status</h2>
        {{#if active}}
          <div class="genesys-round-metric-v1824"><span>Regular activations</span><strong>{{activationUsedCount}} / {{activationTotalCount}}</strong></div>
          <div class="genesys-round-metric-v1824"><span>Pending extras</span><strong>{{pendingSpecialCount}}</strong></div>
          <div class="genesys-round-metric-v1824"><span>Active participants</span><strong>{{activeParticipantCount}}</strong></div>
        {{else}}
          <p>Add selected tokens and collect initiative rolls before starting.</p>
        {{/if}}
      </section>
      <section>
        <h2>Encounter Rules</h2>
        {{#if modeSide}}<p>Slots belong to a side, not to the Actor who rolled them.</p>{{else}}<p>The initiative winner starts. Afterwards, any eligible participant who has not acted may claim.</p>{{/if}}
        <p>Wounds and encounter status are separate. The GM decides when someone is Defeated, Out of Fight, or Dead.</p>
      </section>
    </aside>
  </div>

  {{#if isGM}}
    <footer class="genesys-gm-encounter-controls genesys-gm-controls-v1824">
      {{#if active}}
        <button type="button" data-action="rewindTurn">Previous / Reopen Turn</button>
        <button type="button" data-action="roundDown">Round −</button>
        <button type="button" data-action="roundUp">Round +</button>
        {{#if hasActiveActor}}<button type="button" data-action="forceEndTurn">Force End Turn</button>{{/if}}
        <button type="button" data-action="endEncounter">End Encounter</button>
      {{/if}}
      <button type="button" data-action="resetEncounter">Reset Encounter</button>
    </footer>
  {{/if}}
</section>
